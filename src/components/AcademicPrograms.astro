---
import { Image } from 'astro:assets';
import studentImg from '../assets/images/imagen1_referencial.avif';
import florVinoSvg from '../assets/FLOR-CONCHO-VINO.svg';

const programs = [
  {
    title: 'Primaria',
    description: 'Bases solidas para un gran futuro',
    image: studentImg,
    href: '#primaria',
    featured: false
  },
  {
    title: 'Secundaria',
    description: 'Bases solidas para un gran futuro',
    image: studentImg,
    href: '#secundaria',
    featured: false
  },
  {
    title: 'Bachillerato',
    description: 'Bases solidas para un gran futuro',
    image: studentImg,
    href: '#bachillerato',
    featured: false
  }
];

const featuredProgram = {
  title: 'Bachillerato Dual',
  description: 'Bases solidas para un gran futuro',
  image: studentImg,
  href: '#bachillerato-dual',
  featured: true
};
---

<section id="oferta-academica" class="py-12 lg:py-16 xl:py-20 bg-[#ddd2c6] relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
      <span class="text-[11px] font-bold tracking-widest text-brand-burgundy uppercase block mb-2 font-sans">
        OFERTA ACADÉMICA
      </span>
      <h2 class="text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
        Programas académicos
      </h2>
      <p class="text-brand-charcoal/80 text-base lg:text-lg font-medium">
        Tres etapas, bachillerato dual, un mismo proposito: formar grandes personas
      </p>
    </div>

    <!-- Top 3 Programs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 w-full mb-8">
      {programs.map((item) => (
        <div class="group flex flex-col transition-transform duration-300 hover:-translate-y-1.5">
          <!-- Card Image -->
          <div class="rounded-3xl overflow-hidden h-56 w-full shadow-md bg-brand-sand">
            <Image
              src={item.image}
              alt={item.title}
              width={600}
              height={400}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Card Info Banner -->
          <div class="bg-white/95 rounded-[2rem] p-5 shadow-lg shadow-brand-charcoal/5 -mt-8 relative z-10 mx-4 flex items-center justify-between border border-white/80">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-[#f2ece4] flex items-center justify-center text-brand-burgundy flex-shrink-0 shadow-inner">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif font-bold text-xl text-brand-charcoal leading-snug">
                  {item.title}
                </h3>
                <p class="text-xs text-brand-charcoal/75 font-normal mt-0.5">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Action Arrow Button -->
            <a
              href={item.href}
              aria-label={`Ver más sobre ${item.title}`}
              class="w-10 h-10 rounded-full bg-brand-burgundy text-white flex items-center justify-center flex-shrink-0 ml-2 shadow-sm hover:bg-brand-burgundy-dark transition-colors"
            >
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Featured Bottom Program: Bachillerato Dual -->
    <div class="flex justify-center items-center relative mt-2">
      <div class="relative w-full md:w-[calc(50%-0.75rem)] lg:w-[calc((100%-4rem)/3)]">
        <!-- Left Floral Branch -->
        <div class="hidden sm:block absolute -left-12 lg:-left-16 top-1/2 -translate-y-1/2 w-10 lg:w-14 h-auto pointer-events-none select-none z-0">
          <img
            src={florVinoSvg.src}
            alt=""
            class="w-full h-auto object-contain -scale-x-100 opacity-90"
            aria-hidden="true"
          />
        </div>

        <!-- Right Floral Branch -->
        <div class="hidden sm:block absolute -right-12 lg:-right-16 top-1/2 -translate-y-1/2 w-10 lg:w-14 h-auto pointer-events-none select-none z-0">
          <img
            src={florVinoSvg.src}
            alt=""
            class="w-full h-auto object-contain opacity-90"
            aria-hidden="true"
          />
        </div>

        <div class="group flex flex-col transition-transform duration-300 hover:-translate-y-1.5 relative z-10">
        <!-- Card Image -->
        <div class="rounded-3xl overflow-hidden h-56 w-full shadow-md bg-brand-sand">
          <Image
            src={featuredProgram.image}
            alt={featuredProgram.title}
            width={600}
            height={400}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>

        <!-- Featured Card Info Banner in Burgundy -->
        <div class="bg-brand-burgundy text-white rounded-[2rem] p-5 shadow-xl -mt-8 relative z-10 mx-4 flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-burgundy-dark flex items-center justify-center text-white/90 flex-shrink-0 shadow-inner">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-bold text-xl text-white leading-snug">
                {featuredProgram.title}
              </h3>
              <p class="text-xs text-white/80 font-normal mt-0.5">
                {featuredProgram.description}
              </p>
            </div>
          </div>

          <!-- White Action Arrow Button -->
          <a
            href={featuredProgram.href}
            aria-label={`Ver más sobre ${featuredProgram.title}`}
            class="w-10 h-10 rounded-full bg-white text-brand-burgundy flex items-center justify-center flex-shrink-0 ml-2 shadow-sm hover:bg-white/90 transition-colors"
          >
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  </div>
</section>
