---
import florVinoSvg from '../assets/FLOR-CONCHO-VINO.svg';
---

<!-- Metodología compartida por todos los niveles: resumen con enlace a /metodologia -->
<section id="metodologia" class="py-12 lg:py-16 bg-brand-sand relative overflow-hidden section-border-bottom">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    <div class="reveal-on-scroll" data-animate="animate__fadeInUp">
      <div class="relative overflow-hidden rounded-3xl lg:rounded-[2.5rem] bg-brand-charcoal text-white px-6 sm:px-10 lg:px-14 py-8 sm:py-10 lg:py-12 shadow-xl">
        <div class="absolute -left-10 -top-12 w-48 lg:w-64 h-auto pointer-events-none select-none opacity-10" aria-hidden="true">
          <img src={florVinoSvg.src} alt="" class="w-full h-auto object-contain" />
        </div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
          <div class="lg:col-span-8">
            <span class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-[#ead9c8] font-sans">
              Una misma metodología en todos los niveles
            </span>
            <h2 class="font-serif font-bold text-2xl sm:text-3xl lg:text-[2.15rem] leading-tight mt-2 mb-3">
              Los estudiantes, el centro del proceso educativo
            </h2>
            <p class="text-white/85 text-sm sm:text-base lg:text-[1.05rem] leading-relaxed font-sans max-w-2xl">
              Desde Educación Inicial hasta Bachillerato aplicamos un enfoque social-crítico y constructivista-dialógico: talleres grupales, aprendizaje por descubrimiento, proyectos y conservación ambiental.
            </p>
          </div>

          <div class="lg:col-span-4 flex lg:justify-end">
            <a
              href="/metodologia"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-brand-charcoal font-bold text-sm sm:text-base hover:bg-[#ece7dc] transition-colors shadow-md group/btn focus-visible:ring-2 focus-visible:ring-white"
            >
              <span>Conoce nuestra metodología</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
