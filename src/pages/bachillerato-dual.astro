      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-20 reveal-on-scroll" data-animate="animate__fadeInUp">
        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-6 text-brand-sand">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
