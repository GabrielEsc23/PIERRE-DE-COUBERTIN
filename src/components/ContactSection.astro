---
import { Image } from 'astro:assets';
import formBgImg from '../assets/images/conocenos_form_bg.jpeg';
import florSvg from '../assets/FLOR-BEIGE.svg';
---

<section id="contactos" class="py-12 lg:py-16 xl:py-20 bg-brand-sand relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <!-- Unified Split Card Container -->
    <div 
      class="w-full grid grid-cols-1 lg:grid-cols-12 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white/60 reveal-on-scroll"
      data-animate="animate__fadeInUp"
    >
      
      <!-- Left Column: Information Block with Campus Background ("Te invitamos a conocernos") -->
      <div class="lg:col-span-6 text-white p-6 sm:p-8 lg:p-10 xl:p-12 flex flex-col justify-between relative overflow-hidden">
        <!-- Campus Architecture Background Image -->
        <div class="absolute inset-0 z-0">
          <Image
            src={formBgImg}
            alt="Campus Colegio Pierre de Coubertin"
            width={1200}
            height={900}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
          <!-- Dark Charcoal Overlay to ensure high contrast and readability for text and icons -->
          <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal/90 via-brand-charcoal/85 to-brand-charcoal-dark/95 backdrop-blur-[1px]"></div>
        </div>

        <!-- Subtle watermark -->
        <div class="absolute -right-10 -bottom-10 w-48 h-auto opacity-10 pointer-events-none select-none z-0">
          <img src={florSvg.src} alt="" class="w-full h-auto object-contain" aria-hidden="true" />
        </div>

        <div class="relative z-10 space-y-6">
          <!-- Header -->
          <div>
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-[#ddd2c6] uppercase block mb-1 font-sans">
              CONTÁCTANOS
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-white">
              Te invitamos a conocernos
            </h2>
          </div>

          <!-- Dirección & Interactive Map Card -->
          <div class="space-y-3">
            <span class="text-xs sm:text-sm font-bold text-[#ddd2c6] uppercase tracking-wider block">
              Dirección
            </span>
            <p class="text-base text-white/95 font-medium">
              Victoria central
            </p>

            <!-- Map Card matching PDF -->
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 p-4 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-sm border border-white/20 transition-all duration-300 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-charcoal"
            >
              <div class="w-12 h-12 rounded-xl bg-brand-burgundy text-white flex items-center justify-center flex-shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-serif font-bold text-base sm:text-lg text-white leading-snug">
                  Colegio Pierre de Coubertin
                </p>
                <p class="text-xs sm:text-sm text-[#ddd2c6]">
                  Victoria central
                </p>
                <span class="text-xs sm:text-sm font-semibold text-[#f3f0e8] underline group-hover:text-white transition-colors mt-0.5 inline-block">
                  Ver en Google Maps →
                </span>
              </div>
            </a>
          </div>

          <!-- Teléfono -->
          <div>
            <span class="text-xs sm:text-sm font-bold text-[#ddd2c6] uppercase tracking-wider block mb-1">
              Teléfono
            </span>
            <p class="text-lg sm:text-xl font-serif font-bold text-white">
              02 - 3076792
            </p>
          </div>

          <!-- Horarios de atención -->
          <div>
            <span class="text-xs sm:text-sm font-bold text-[#ddd2c6] uppercase tracking-wider block mb-1">
              Horarios de atención
            </span>
            <p class="text-xs sm:text-sm text-white/95">
              Lun - Vier: 7H00 - 13H00
            </p>
            <p class="text-xs sm:text-sm text-white/95 mt-0.5">
              Atención Administrativa y Admisiones
            </p>
          </div>

          <!-- Redes Sociales -->
          <div class="pt-2">
            <span class="text-xs sm:text-sm font-bold text-[#ddd2c6] uppercase tracking-wider block mb-3 font-sans">
              Síguenos en redes
            </span>
            <div class="flex items-center gap-2.5">
              <!-- Facebook -->
              <a
                href="https://facebook.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook Colegio Pierre de Coubertin"
                class="w-10 h-10 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
              >
                <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>

              <!-- Instagram -->
              <a
                href="https://instagram.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram Colegio Pierre de Coubertin"
                class="w-10 h-10 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
              >
                <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>

              <!-- TikTok -->
              <a
                href="https://tiktok.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TikTok Colegio Pierre de Coubertin"
                class="w-10 h-10 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
              >
                <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 00-.88-.06A6.34 6.34 0 003.15 15.7a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.22a8.16 8.16 0 004.76 1.52V7.32a4.85 4.85 0 01-1-.63z"/>
                </svg>
              </a>

              <!-- YouTube -->
              <a
                href="https://youtube.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube Colegio Pierre de Coubertin"
                class="w-10 h-10 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
              >
                <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Clean White Form Block -->
      <div class="lg:col-span-6 bg-white p-6 sm:p-8 lg:p-10 xl:p-12 flex flex-col justify-center">
        <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-2">
          Envíanos un mensaje
        </h3>
        <p class="text-sm sm:text-base text-brand-charcoal-dark mb-8 font-sans font-medium">
          Déjanos tus datos y nos pondremos en contacto contigo a la brevedad.
        </p>

        <form class="space-y-5" onsubmit="event.preventDefault();">
          <div>
            <label for="nombre" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-charcoal mb-1.5 font-sans">
              Nombre completo
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder="Ej. Juan Pérez"
              class="w-full px-4 py-3.5 rounded-xl border border-brand-sand bg-brand-cream/30 text-brand-charcoal placeholder:text-brand-charcoal/60 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-brand-burgundy focus:border-brand-burgundy transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-charcoal mb-1.5 font-sans">
              Correo electrónico
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="ejemplo@correo.com"
              class="w-full px-4 py-3.5 rounded-xl border border-brand-sand bg-brand-cream/30 text-brand-charcoal placeholder:text-brand-charcoal/60 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-brand-burgundy focus:border-brand-burgundy transition-all"
            />
          </div>

          <div>
            <label for="mensaje" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-charcoal mb-1.5 font-sans">
              Mensaje
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="4"
              required
              placeholder="¿En qué podemos ayudarte?"
              class="w-full px-4 py-3.5 rounded-xl border border-brand-sand bg-brand-cream/30 text-brand-charcoal placeholder:text-brand-charcoal/60 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-brand-burgundy focus:border-brand-burgundy transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 rounded-xl bg-brand-burgundy text-white font-serif font-bold text-base sm:text-lg tracking-wider uppercase hover:bg-brand-burgundy-dark transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.99] cursor-pointer focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
          >
            Enviar mensaje
          </button>
        </form>
      </div>

    </div>

  </div>
</section>
