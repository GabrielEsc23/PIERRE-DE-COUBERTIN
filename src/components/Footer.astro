---
import { Image } from 'astro:assets';
import logoImg from '../assets/LOGO COLEGIO.png';

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Oferta Académica', href: '/#oferta-academica' },
  { name: 'Servicios Adicionales', href: '/#servicios-adicionales' },
  { name: 'Admisiones', href: '/admisiones' },
  { name: 'Noticias', href: '/#noticias-eventos' },
  { name: 'Contacto', href: '/#contactos' },
];

const academicLinks = [
  { name: 'Educación Inicial 2', href: '/#inicial-2' },
  { name: 'Educación General Básica', href: '/#egb' },
  { name: 'Preparatoria', href: '/#preparatoria' },
  { name: 'Bachillerato', href: '/#bachillerato' },
  { name: 'Bachillerato Dual', href: '/#bachillerato-dual' },
];
---

<footer class="bg-brand-burgundy text-white pt-12 pb-8 border-t border-white/10 relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    
    <!-- Top 4 Columns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-8 lg:pb-10 border-b border-white/15">
      
      <!-- Column 1: Brand & Tagline (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="p-2 bg-white rounded-2xl shadow-md">
            <Image 
              src={logoImg} 
              alt="Unidad Educativa Pierre de Coubertin" 
              width={54}
              height={62}
              class="h-12 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col leading-tight">
            <span class="font-serif font-bold text-white text-xl sm:text-2xl tracking-wider">PIERRE DE</span>
            <span class="font-serif font-bold text-white text-xl sm:text-2xl tracking-wider">COUBERTIN</span>
            <span class="text-[10px] sm:text-xs font-semibold tracking-[0.16em] text-[#ddd2c6] uppercase whitespace-nowrap">UNIDAD EDUCATIVA</span>
          </div>
        </div>

        <p class="text-sm sm:text-base font-serif italic text-[#ddd2c6] tracking-wide pt-1">
          Valores - Conocimiento - Futuro
        </p>

        <p class="text-sm sm:text-base text-white/85 font-sans leading-relaxed max-w-sm">
          Educación integral basada en la excelencia académica, el desarrollo humano, valores éticos y el compromiso con la sociedad.
        </p>
      </div>

      <!-- Column 2: Navegación (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-serif font-bold text-white text-lg sm:text-xl tracking-wide border-b border-white/20 pb-2 inline-block">
          Navegación
        </h3>
        <ul class="space-y-2.5 text-sm sm:text-base text-white/90 font-sans">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#ddd2c6] transition-colors flex items-center gap-1.5 focus-visible:ring-1 focus-visible:ring-white">
                <span class="text-white/60" aria-hidden="true">›</span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Oferta Académica (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-serif font-bold text-white text-lg sm:text-xl tracking-wide border-b border-white/20 pb-2 inline-block">
          Oferta Académica
        </h3>
        <ul class="space-y-2.5 text-sm sm:text-base text-white/90 font-sans">
          {academicLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#ddd2c6] transition-colors flex items-center gap-1.5 focus-visible:ring-1 focus-visible:ring-white">
                <span class="text-white/60" aria-hidden="true">›</span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Síguenos & Redes Sociales (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="font-serif font-bold text-white text-lg sm:text-xl tracking-wide border-b border-white/20 pb-2 inline-block">
          Síguenos
        </h3>
        
        <!-- Social Icons Row matching PDF -->
        <div class="flex items-center gap-2.5">
          <!-- Facebook -->
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-9 h-9 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="w-9 h-9 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 00-.88-.06A6.34 6.34 0 003.15 15.7a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.22a8.16 8.16 0 004.76 1.52V7.32a4.85 4.85 0 01-1-.63z"/>
            </svg>
          </a>

          <!-- YouTube / Video -->
          <a
            href="https://youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="w-9 h-9 rounded-full bg-white/15 hover:bg-white text-white hover:text-brand-burgundy flex items-center justify-center transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>

        <!-- Contact info in footer -->
        <div class="pt-2 space-y-1.5 text-xs text-white/80 font-sans">
          <span class="text-[10px] font-bold tracking-wider uppercase text-[#ddd2c6] block">Contacto</span>
          <a href="mailto:support_pc@uepierredecoubertin.edu.ec" class="hover:text-white transition-colors block break-all">
            support_pc@uepierredecoubertin.edu.ec
          </a>
          <div class="space-y-1 pt-0.5">
            <a href="tel:0984530158" class="hover:text-white transition-colors block font-semibold text-white/95">
              098 453 0158
            </a>
            <a href="tel:023076792" class="hover:text-white transition-colors block font-semibold text-white/95">
              02 - 3076792
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar with Legal Links and Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-white/70 font-sans">
      <div class="flex items-center gap-6">
        <a href="#terminos" class="hover:text-white transition-colors">Términos y condiciones</a>
        <span>|</span>
        <a href="#privacidad" class="hover:text-white transition-colors">Política de privacidad</a>
      </div>
      
      <p class="text-center sm:text-right text-[#ddd2c6]">
        &copy; 2026 Pierre de Coubertin. Todos los derechos reservados.
      </p>
    </div>

  </div>
</footer>
