  { key: 'refrigerio', label: 'Refrigerio', group: { name: 'Media mañana', time: '10:00 – 10:30' } },
  { key: 'entrada', label: 'Sopa o entrada', group: { name: 'Almuerzo', time: '12:30 – 13:30' } },
  { key: 'fuerte', label: 'Plato fuerte', strong: true },
  { key: 'guarnicion', label: 'Guarnición' },
