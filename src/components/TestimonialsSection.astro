---
import florSvg from '../assets/FLOR-CONCHO-VINO.svg';

const testimonials = [
  {
    quote: 'La confianza de nuestra comunidad nos impulsa a seguir mejorando cada día en la formación integral de nuestros hijos.',
    role: 'MADRE DE FAMILIA',
    name: 'SANDRA ALBÁN'
  },
  {
    quote: 'Un ambiente donde los valores y la excelencia académica van de la mano. Los profesores están siempre atentos al desarrollo de cada estudiante.',
    role: 'PADRE DE FAMILIA',
    name: 'CARLOS MENDOZA'
  },
  {
    quote: 'Agradecemos el compromiso y la calidez con que guían a nuestros jóvenes para alcanzar sus sueños y metas universitarias.',
    role: 'MADRE DE FAMILIA',
    name: 'LUCÍA PAREDES'
  }
];
---

<section id="comunidad" class="py-12 lg:py-16 xl:py-20 bg-brand-beige relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    
    <!-- Section Header Centered with Flanking Leaves -->
    <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
      <div class="flex items-center justify-center gap-3 mb-2">
        <img
          src={florSvg.src}
          alt=""
          class="w-6 h-6 object-contain -scale-x-100"
          aria-hidden="true"
        />
        <span class="text-xs font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans">
          LO QUE DICE NUESTRA COMUNIDAD
        </span>
        <img
          src={florSvg.src}
          alt=""
          class="w-6 h-6 object-contain"
          aria-hidden="true"
        />
      </div>

      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-brand-charcoal mb-3">
        La confianza de nuestra comunidad nos impulsa a seguir mejorando
      </h2>
      <p class="text-brand-charcoal-dark font-medium text-sm sm:text-base font-sans">
        Testimonios de las familias que forman parte activa del proyecto educativo Pierre de Coubertin.
      </p>
    </div>

    <!-- 3 Testimonials Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 w-full">
      {testimonials.map((item, index) => (
        <div class="group flex flex-col justify-between bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 border border-brand-sand/60 relative">
          
          <div>
            <!-- Burgundy Circular Quote Icon -->
            <div class="w-12 h-12 rounded-full bg-brand-burgundy text-white flex items-center justify-center shadow-md mb-6 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>

            <!-- Quote Text -->
            <p class="text-brand-charcoal text-sm sm:text-base font-sans leading-relaxed italic mb-6">
              "{item.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-brand-charcoal/10">
            <span class="text-[10px] font-bold tracking-widest text-brand-burgundy uppercase block font-sans">
              {item.role}
            </span>
            <span class="font-serif font-bold text-sm sm:text-base text-brand-charcoal block mt-0.5">
              {item.name}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
