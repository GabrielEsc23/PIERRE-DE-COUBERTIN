---
import { getImage } from 'astro:assets';
import heroImg1 from '../assets/images/portada_1.jpeg';
import heroImg2 from '../assets/images/portada_2.0.jpeg';
import florBeigeSvg from '../assets/FLOR-BEIGE.svg';

const bg1 = await getImage({ src: heroImg1, format: 'webp', width: 2048 });
const bg2 = await getImage({ src: heroImg2, format: 'webp', width: 2048 });
---

<section 
  class="relative py-20 sm:py-24 lg:py-28 xl:py-36 bg-brand-burgundy text-white overflow-hidden section-border-bottom-dark"
>
  <!-- Background Image Crossfade Layer between portada_1 and portada_2.0 with fixed parallax -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none">
    <!-- Slide 1: portada_1.jpeg (positioned at top so the top is fully visible and not cut off) -->
    <div 
      id="hero-slide-1" 
      class="hero-slide absolute inset-0 w-full h-full bg-cover bg-[center_top] bg-no-repeat bg-fixed transition-opacity duration-1000 ease-in-out opacity-100 z-10"
      style={`background-image: url(${bg1.src});`}
    ></div>

    <!-- Slide 2: portada_2.0.jpeg (fixed background) -->
    <div 
      id="hero-slide-2" 
      class="hero-slide absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat bg-fixed transition-opacity duration-1000 ease-in-out opacity-0 z-0"
      style={`background-image: url(${bg2.src});`}
    ></div>
  </div>

  <!-- Burgundy overlay with balanced opacity to reveal photos and keep text crisp (matching Admissions Banner) -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-burgundy-dark/85 via-brand-burgundy/80 to-brand-burgundy-dark/90 pointer-events-none z-1"></div>

  <!-- Decorative feather watermarks -->
  <div class="absolute -left-12 top-1/2 -translate-y-1/2 w-48 lg:w-60 h-auto pointer-events-none select-none opacity-15 z-2">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain"
      aria-hidden="true"
    />
  </div>
  <div class="absolute -right-12 top-1/2 -translate-y-1/2 w-48 lg:w-60 h-auto pointer-events-none select-none opacity-15 z-2">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain -scale-x-100"
      aria-hidden="true"
    />
  </div>

  <!-- Content Container (Centered layout matching Admissions Banner) -->
  <div class="relative z-10 w-full px-4 sm:px-6 lg:px-8 xl:px-10 max-w-4xl xl:max-w-5xl mx-auto text-center">
    
    <!-- Subtitle / Tagline -->
    <div class="mb-4 animate__animated animate__fadeInDown">
      <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-[#ddd2c6] uppercase font-sans">
        FORMACIÓN INTEGRAL · VALORES · FUTURO
      </span>
    </div>

    <!-- Main Title & Quote Citation -->
    <div class="mb-6 animate__animated animate__fadeInUp" style="animation-delay: 100ms;">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] xl:text-[3.65rem] font-serif font-bold text-white leading-tight">
        "Lo mejor <span class="text-[#f5eedf]">que tienen</span> los sueños, es que se pueden <span class="text-[#f5eedf]">hacer realidad"</span>
      </h1>
      <cite class="not-italic block mt-3.5 text-xs sm:text-sm md:text-base font-sans font-semibold tracking-[0.22em] text-[#ddd2c6] uppercase">
        — Pierre de Coubertin
      </cite>
    </div>

    <!-- Welcoming Description -->
    <p class="text-white/90 font-sans text-base sm:text-lg lg:text-xl leading-relaxed mb-8 sm:mb-10 max-w-2xl sm:max-w-3xl mx-auto animate__animated animate__fadeInUp" style="animation-delay: 200ms;">
      Una educación integral que potencia el talento, los valores y la confianza de cada estudiante para transformar su futuro.
    </p>

    <!-- Single Action CTA Button -->
    <div class="flex items-center justify-center animate__animated animate__fadeInUp" style="animation-delay: 300ms;">
      <a
        href="#contactos"
        class="inline-flex items-center gap-2.5 px-9 py-4 rounded-full bg-white text-brand-burgundy font-bold text-base sm:text-lg hover:bg-[#ece7dc] transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 group focus-visible:ring-2 focus-visible:ring-white"
      >
        <span>Solicitar Información</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  function initHeroCrossfade() {
    const slide1 = document.getElementById('hero-slide-1');
    const slide2 = document.getElementById('hero-slide-2');

    if (!slide1 || !slide2) return;

    let currentIndex = 0;
    let timer: number | undefined;

    function goToSlide(index: number) {
      currentIndex = index;
      if (currentIndex === 0) {
        slide1?.classList.remove('opacity-0', 'z-0');
        slide1?.classList.add('opacity-100', 'z-10');

        slide2?.classList.remove('opacity-100', 'z-10');
        slide2?.classList.add('opacity-0', 'z-0');
      } else {
        slide2?.classList.remove('opacity-0', 'z-0');
        slide2?.classList.add('opacity-100', 'z-10');

        slide1?.classList.remove('opacity-100', 'z-10');
        slide1?.classList.add('opacity-0', 'z-0');
      }
    }

    function startAutoLoop() {
      if (timer) clearInterval(timer);
      timer = window.setInterval(() => {
        if (!document.hidden) {
          goToSlide(currentIndex === 0 ? 1 : 0);
        }
      }, 5000);
    }

    startAutoLoop();
  }

  // Support initial load and Astro page transitions
  initHeroCrossfade();
  document.addEventListener('astro:page-load', initHeroCrossfade);
</script>

