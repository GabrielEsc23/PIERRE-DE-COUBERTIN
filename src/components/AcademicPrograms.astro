---
import florVinoSvg from '../assets/FLOR-CONCHO-VINO.svg';

const programs = [
  {
    title: 'Educación Inicial 2',
    description: 'Estimulación temprana, curiosidad y desarrollo motriz',
    image: 'https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=800&q=80',
    href: '#inicial-2',
    icon: 'sparkles'
  },
  {
    title: 'Preparatoria',
    description: 'Primeros pasos hacia la lectoescritura y lógica matemática',
    image: 'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=800&q=80',
    href: '#preparatoria',
    icon: 'pencil'
  },
  {
    title: 'Educación General Básica',
    description: 'Pensamiento crítico, ciencias y valores formativos',
    image: 'https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=800&q=80',
    href: '#egb',
    icon: 'book'
  },
  {
    title: 'Bachillerato',
    description: 'Preparación académica y proyección preuniversitaria',
    image: 'https://images.unsplash.com/photo-1571260899304-425eee4c7efc?auto=format&fit=crop&w=800&q=80',
    href: '#bachillerato',
    icon: 'academic'
  }
];

const featuredProgram = {
  title: 'Bachillerato Dual',
  description: 'Doble titulación internacional con EE.UU.',
  image: 'https://images.unsplash.com/photo-1606761568499-6d2451b23c66?auto=format&fit=crop&w=800&q=80',
  href: '/bachillerato-dual',
  featured: true
};
---

<section id="oferta-academica" class="py-12 lg:py-16 xl:py-20 bg-brand-sand relative overflow-hidden section-border-bottom">
  <!-- Right-side burgundy gradient accent (matching DEGRADADO.svg in pure performant CSS) -->
  <div class="section-gradient-right" aria-hidden="true"></div>

  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12 reveal-on-scroll" data-animate="animate__fadeInUp">
      <span class="text-xs sm:text-sm font-bold tracking-widest text-brand-burgundy uppercase block mb-2 font-sans">
        OFERTA ACADÉMICA
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-[3.25rem] font-serif font-bold text-brand-charcoal mb-4 break-words">
        Programas académicos
      </h2>
      <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed">
        Formación integral por etapas y bachillerato dual internacional: un mismo propósito de excelencia
      </p>
    </div>

    <!-- 4 Foundational Programs Grid (Equal Height with Single-Line Titles) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 w-full mb-8 lg:mb-10 items-stretch">
      {programs.map((item, idx) => (
        <div 
          class="group flex flex-col transition-transform duration-300 hover:-translate-y-1.5 reveal-on-scroll h-full"
          data-animate="animate__fadeInUp"
          data-delay={`${idx * 120}ms`}
        >
          <!-- Card Image -->
          <div class="rounded-3xl overflow-hidden h-48 sm:h-52 w-full shadow-md bg-brand-sand shrink-0">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Card Info Banner: Equal Height, Single Line Title -->
          <div class="bg-white rounded-[1.75rem] p-3.5 sm:p-4 shadow-lg shadow-brand-charcoal/5 -mt-8 relative z-10 mx-2.5 sm:mx-3 flex items-center justify-between border border-white/80 flex-1 min-h-[92px] sm:min-h-[98px]">
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1 pr-1.5">
              <div class="w-10 h-10 sm:w-10.5 sm:h-10.5 rounded-full bg-[#f2ece4] flex items-center justify-center text-brand-burgundy flex-shrink-0 shadow-inner">
                {item.icon === 'sparkles' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
                  </svg>
                )}
                {item.icon === 'pencil' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                  </svg>
                )}
                {item.icon === 'book' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                )}
                {item.icon === 'academic' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
                  </svg>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <h3 
                  class="font-serif font-bold text-xs sm:text-[13.5px] xl:text-[14.5px] 2xl:text-[15.5px] text-brand-charcoal leading-tight whitespace-nowrap overflow-hidden text-ellipsis"
                  title={item.title}
                >
                  {item.title}
                </h3>
                <p class="text-[11px] sm:text-xs text-brand-charcoal-dark font-medium mt-0.5 leading-snug line-clamp-1">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Action Arrow Button -->
            <a
              href={item.href}
              aria-label={`Ver más sobre ${item.title}`}
              class="w-8.5 h-8.5 sm:w-9 sm:h-9 rounded-full bg-brand-burgundy text-white flex items-center justify-center flex-shrink-0 shadow-sm hover:bg-brand-burgundy-dark transition-colors focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Flagship Horizontal Card: Bachillerato Dual -->
    <div class="mt-8 lg:mt-10 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay="150ms">
      <div class="group relative rounded-3xl lg:rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-brand-burgundy via-brand-burgundy to-[#4a0018] text-white shadow-xl hover:shadow-2xl transition-all duration-300 border border-white/15">
        
        <!-- Subtle decorative watermark inside banner -->
        <div class="absolute -right-12 -bottom-16 w-56 lg:w-72 h-auto pointer-events-none select-none opacity-10 z-0">
          <img src={florVinoSvg.src} alt="" class="w-full h-auto object-contain" aria-hidden="true" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch relative z-10">
          
          <!-- Left Column: High-Impact Image -->
          <div class="lg:col-span-5 relative overflow-hidden min-h-[240px] sm:min-h-[280px] lg:min-h-[340px]">
            <img
              src={featuredProgram.image}
              alt={featuredProgram.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-brand-burgundy/80 via-transparent to-transparent opacity-60"></div>
            
            <!-- Float Badge on Image -->
            <div class="absolute top-4 left-4 sm:top-5 sm:left-5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-xs font-bold uppercase tracking-wider text-white shadow-md">
              <span class="w-2 h-2 rounded-full bg-[#f3d08c] animate-pulse"></span>
              <span>Doble Titulación Oficial</span>
            </div>
          </div>

          <!-- Right Column: Editorial Value Proposition -->
          <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
            <div>
              <!-- Category Header Tag -->
              <div class="flex items-center gap-2 mb-2.5">
                <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-[#f8ebd2] uppercase font-sans">
                  PROGRAMA INTERNACIONAL EXCLUSIVO
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-2xl sm:text-3xl lg:text-[2.15rem] font-serif font-bold text-white leading-tight mb-3">
                Bachillerato Dual Americano
              </h3>

              <!-- Description -->
              <p class="text-white/90 text-sm sm:text-base lg:text-[1.05rem] leading-relaxed font-sans mb-5 max-w-xl">
                Obtén simultáneamente el título de Bachiller ecuatoriano y el diploma oficial de High School de los Estados Unidos sin salir del país.
              </p>

              <!-- 3 Bullet Highlights -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 mb-6 sm:mb-8 pt-1">
                <div class="flex items-start gap-2 bg-white/10 rounded-xl p-2.5 border border-white/10">
                  <svg class="w-4 h-4 text-[#f3d08c] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span class="text-xs sm:text-[13px] text-white/95 font-medium leading-snug">
                    Diploma oficial de EE.UU.
                  </span>
                </div>

                <div class="flex items-start gap-2 bg-white/10 rounded-xl p-2.5 border border-white/10">
                  <svg class="w-4 h-4 text-[#f3d08c] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span class="text-xs sm:text-[13px] text-white/95 font-medium leading-snug">
                    Inmersión 100% bilingüe
                  </span>
                </div>

                <div class="flex items-start gap-2 bg-white/10 rounded-xl p-2.5 border border-white/10">
                  <svg class="w-4 h-4 text-[#f3d08c] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span class="text-xs sm:text-[13px] text-white/95 font-medium leading-snug">
                    Acceso universitario global
                  </span>
                </div>
              </div>
            </div>

            <!-- CTA Row -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-white/15">
              <span class="text-xs sm:text-sm text-[#f8ebd2]/90 font-serif italic">
                Convenio oficial acreditado internacionalmente
              </span>

              <a
                href="/bachillerato-dual"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-brand-burgundy font-bold text-sm sm:text-base hover:bg-[#ece7dc] transition-all duration-200 shadow-md hover:shadow-lg group/btn focus-visible:ring-2 focus-visible:ring-white"
              >
                <span>Conoce el Bachillerato Dual</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>

          </div>

        </div>

      </div>
    </div>

  </div>
</section>
