---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import fotoHero from '../assets/images/educacion_inicial_4.jpeg';
import fotoJuego from '../assets/images/educacion_inicial_2.jpeg';
import fotoDescubrimiento from '../assets/images/educacion_inicial_1.jpeg';
import fotoProyectos from '../assets/images/educacion_inicial_5.jpeg';

const methods = [
  {
    title: 'Aprendizaje basado en el juego',
    text: 'Utilizamos el juego como principal herramienta de aprendizaje, permitiendo que los niños desarrollen habilidades cognitivas, sociales, emocionales y motrices. Mediante actividades lúdicas, dinámicas y recreativas, fortalecen sus conocimientos mientras exploran, interactúan y se divierten.',
    image: fotoJuego,
    alt: 'Niños de Educación Inicial recostados en el césped mostrando sus manos pintadas de colores',
  },
  {
    title: 'Aprendizaje por descubrimiento',
    text: 'Promovemos experiencias que despiertan la curiosidad y motivan a los niños a explorar, experimentar, observar y formular preguntas. De esta manera, construyen sus propios conocimientos a partir de la interacción con el entorno, desarrollando el pensamiento crítico, la creatividad y la capacidad de resolver pequeños desafíos.',
    image: fotoDescubrimiento,
    alt: 'Dos niños observando un experimento de colores en platos sobre la mesa',
  },
  {
    title: 'Aprendizaje basado en proyectos',
    text: 'Impulsamos el desarrollo de proyectos que integran diferentes áreas del conocimiento mediante actividades prácticas y significativas. Los niños investigan, crean, experimentan y trabajan colaborativamente, aplicando sus aprendizajes en situaciones reales y fortaleciendo su autonomía e iniciativa.',
    image: fotoProyectos,
    alt: 'Niños trabajando juntos en una actividad sensorial al aire libre',
  },
];

const areas = [
  {
    title: 'Pensamiento crítico',
    text: 'Estimulamos la curiosidad, la observación, el razonamiento y la resolución de pequeños problemas, motivando a los niños a preguntar, explorar y expresar sus propias ideas.',
  },
  {
    title: 'Lenguaje y comunicación',
    text: 'Fortalecemos la expresión oral, la comprensión, la ampliación del vocabulario y las habilidades comunicativas, favoreciendo el acercamiento progresivo a la lectura y la preescritura.',
  },
  {
    title: 'Lengua extranjera',
    text: 'Promovemos el aprendizaje de una segunda lengua mediante canciones, juegos, cuentos y actividades interactivas que fortalecen la comprensión auditiva, la pronunciación, la adquisición de nuevo vocabulario y el uso de expresiones cotidianas, favoreciendo una comunicación natural y espontánea a través de experiencias lúdicas y significativas.',
  },
  {
    title: 'Inteligencia emocional',
    text: 'Promovemos el reconocimiento, la expresión y la regulación de las emociones, desarrollando la empatía, la autoestima y la confianza en sí mismos.',
  },
  {
    title: 'Autonomía y seguridad',
    text: 'Fomentamos la independencia en las actividades cotidianas, la toma de pequeñas decisiones y la confianza en sus propias capacidades, fortaleciendo su iniciativa y sentido de responsabilidad.',
  },
  {
    title: 'Motricidad fina y gruesa',
    text: 'Desarrollamos la coordinación, el equilibrio y el control corporal mediante actividades de movimiento, juegos, trazos, ensartado, recortado, modelado y manipulación de diferentes materiales.',
  },
  {
    title: 'Creatividad e imaginación',
    text: 'Incentivamos la expresión artística, la exploración y la creación mediante experiencias que permiten imaginar, inventar, experimentar y proponer nuevas ideas.',
  },
  {
    title: 'Convivencia y valores',
    text: 'Fortalecemos el respeto, la solidaridad, la empatía, la cooperación y la resolución pacífica de conflictos, promoviendo relaciones positivas y una convivencia armónica.',
  },
];

const commitments = [
  'Seguimiento académico',
  'Comunicación permanente',
  'Orientación y acompañamiento',
  'Actividades de integración',
];
---

<Layout
  title="Educación Inicial | Colegio Pierre de Coubertin"
  description="Educación Inicial en Pierre de Coubertin: aprender jugando, crecer descubriendo y soñar construyendo. Metodologías activas, desarrollo integral y acompañamiento a las familias."
>
  <Header />

  <main class="flex-grow overflow-x-hidden bg-brand-cream">

    <!-- Hero -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">

        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#oferta-academica" class="hover:text-brand-burgundy transition-colors">Oferta Académica</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Educación Inicial</span>
          </nav>

          <a
            href="/#oferta-academica"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Oferta Académica</span>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans mb-3">
              Educación Inicial
            </span>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              ¡Aprender jugando, crecer descubriendo y <span class="text-brand-burgundy">soñar construyendo!</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-8 font-sans">
              Ofrecemos una educación integral, innovadora y de calidad, enfocada en el desarrollo de habilidades, destrezas, valores y competencias desde los primeros años. Promovemos el aprendizaje mediante el juego, la exploración, la experimentación, la creatividad y la interacción con el entorno, respetando los ritmos y estilos de aprendizaje de cada niño.
            </p>

            <div class="flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href="#metodologia"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors group"
              >
                <span>Conocer la metodología</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>
              <a
                href="/admisiones"
                class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
              >
                <span>Postulaciones 2026-2027</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 w-full">
            <Image
              src={fotoHero}
              alt="Niños de Educación Inicial jugando con aros de colores en el patio del colegio"
              widths={[640, 960, 1360]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center rounded-3xl"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Metodologías: filas alternadas foto + texto -->
    <section id="metodologia" class="py-14 lg:py-20 bg-brand-sand relative section-border-bottom scroll-mt-4">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Metodologías de enseñanza y aprendizaje
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            El niño, <span class="text-brand-burgundy">protagonista de su aprendizaje</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium leading-relaxed font-sans">
            Nuestra propuesta educativa se fundamenta en metodologías activas e innovadoras. A través de experiencias significativas, participativas y adaptadas a sus necesidades, promovemos la curiosidad, la creatividad, la autonomía y el desarrollo integral.
          </p>
        </div>

        <ol class="max-w-6xl mx-auto flex flex-col gap-12 lg:gap-16">
          {methods.map((method, idx) => (
            <li class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 lg:gap-14 items-center reveal-on-scroll" data-animate="animate__fadeInUp">
              <div class:list={['w-full', idx % 2 === 1 && 'md:order-2']}>
                <Image
                  src={method.image}
                  alt={method.alt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  class="w-full h-auto aspect-[4/3] object-cover rounded-3xl"
                  loading="lazy"
                />
              </div>
              <div>
                <span class="block font-serif font-bold text-5xl lg:text-6xl text-brand-burgundy leading-none mb-4" aria-hidden="true">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-4">
                  {method.title}
                </h3>
                <p class="text-base sm:text-lg text-brand-charcoal-dark leading-relaxed font-sans">
                  {method.text}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Desarrollo integral: áreas que potenciamos -->
    <section class="py-14 lg:py-20 bg-brand-cream relative section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-14 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Desarrollo integral
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal">
            Áreas que potenciamos
          </h2>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 lg:gap-6 max-w-7xl mx-auto">
          {areas.map((area, idx) => (
            <li
              class="bg-white rounded-3xl p-6 sm:p-7 border border-brand-charcoal/10 border-t-4 border-t-brand-burgundy reveal-on-scroll"
              data-animate="animate__fadeInUp"
              data-delay={`${(idx % 4) * 80}ms`}
            >
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-3">{area.title}</h3>
              <p class="text-sm sm:text-base text-brand-charcoal-dark leading-relaxed font-sans">{area.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Compromiso con las familias -->
    <section class="py-14 lg:py-20 bg-brand-beige relative section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
          <div class="lg:col-span-5 reveal-on-scroll" data-animate="animate__fadeInUp">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
              Nuestro compromiso con las familias
            </span>
            <h2 class="text-3xl sm:text-4xl font-serif font-bold text-brand-charcoal leading-tight">
              Trabajamos juntos para acompañar el crecimiento y aprendizaje de sus hijos
            </h2>
          </div>

          <ul class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay="100ms">
            {commitments.map((item, idx) => (
              <li class="flex items-baseline gap-4 bg-white rounded-2xl px-6 py-5 border border-brand-charcoal/10">
                <span class="font-serif font-bold text-2xl text-brand-burgundy leading-none" aria-hidden="true">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="text-lg font-semibold text-brand-charcoal">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Nuestra promesa educativa (fondo vino sólido + frase) -->
    <section class="relative py-16 lg:py-24 bg-brand-burgundy text-white overflow-hidden section-border-bottom-dark">
      <div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 text-center reveal-on-scroll" data-animate="animate__fadeInUp">
        <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-[#ead9c8] uppercase font-sans block mb-6">
          Nuestra promesa educativa
        </span>
        <p class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl leading-snug mb-8">
          ¡Formamos pequeños exploradores, grandes soñadores y futuros protagonistas del mundo!
        </p>
        <p class="text-sm sm:text-base font-semibold tracking-widest uppercase text-[#ead9c8]">
          Institución Particular Pierre de Coubertin
        </p>
        <p class="text-sm sm:text-base text-white/80 mt-1">
          Educación integral para un mejor mañana
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-16 bg-brand-cream relative">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl text-brand-charcoal mb-4">
          ¿Quieres conocer nuestra Educación Inicial?
        </h2>
        <p class="text-brand-charcoal-dark text-base sm:text-lg max-w-2xl mx-auto mb-8 font-sans">
          Agenda una visita y conoce nuestros espacios y a nuestro equipo docente.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/admisiones"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors"
          >
            <span>Iniciar proceso de admisión</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/#contactos"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
          >
            <span>Agendar visita</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
