---
import { Image } from 'astro:assets';
import campusImg from '../assets/images/campus_fachada.webp';
import studentImg from '../assets/images/imagen1_referencial.avif';
import florSvg from '../assets/FLOR-CONCHO-VINO.svg';

const newsItems = [
  {
    day: '12',
    month: 'AGOSTO',
    title: 'TORNEO INTERCOLEGIAL DE FUTBOL',
    image: campusImg,
    href: '#noticia-1'
  },
  {
    day: '12',
    month: 'AGOSTO',
    title: 'TORNEO INTERCOLEGIAL DE FUTBOL',
    image: studentImg,
    href: '#noticia-2'
  },
  {
    day: '12',
    month: 'AGOSTO',
    title: 'TORNEO INTERCOLEGIAL DE FUTBOL',
    image: campusImg,
    href: '#noticia-3'
  }
];

const upcomingEvents = [
  {
    date: '16 agosto',
    title: 'EVENTO DE FUTBOL DE COLEGIO',
    time: '8H00 - 13H00'
  },
  {
    date: '16 agosto',
    title: 'EVENTO DE FUTBOL DE COLEGIO',
    time: '8H00 - 13H00'
  },
  {
    date: '16 agosto',
    title: 'EVENTO DE FUTBOL DE COLEGIO',
    time: '8H00 - 13H00'
  }
];
---

<section id="noticias-eventos" class="py-12 lg:py-16 xl:py-20 bg-[#f3f0e8] relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <!-- Section Header -->
    <div class="mb-8 lg:mb-10">
      <div class="inline-flex items-center gap-2 mb-2">
        <img
          src={florSvg.src}
          alt=""
          class="w-5 h-5 object-contain"
          aria-hidden="true"
        />
        <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans">
          NOTICIAS Y EVENTOS
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal">
        Mantente al día con lo que sucede en nuestra comunidad
      </h2>
    </div>

    <!-- 2 Column Layout: News (Left) + Events (Right) with Equal Height -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column: 3 News Cards (7 cols) -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 h-full">
          {newsItems.map((item) => (
            <article class="group flex flex-col bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 border border-brand-sand/50 h-full">
              <!-- News Image -->
              <div class="h-40 sm:h-44 lg:h-48 w-full overflow-hidden bg-brand-sand flex-shrink-0">
                <Image
                  src={item.image}
                  alt={item.title}
                  width={400}
                  height={260}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <!-- Content with Date + Title -->
              <div class="p-4 sm:p-5 flex flex-col justify-between flex-1">
                <div class="flex items-start gap-3 mb-3">
                  <!-- Date Badge -->
                  <div class="flex flex-col items-center justify-center text-brand-burgundy pr-3 border-r border-brand-charcoal/15 flex-shrink-0">
                    <span class="text-2xl sm:text-3xl font-serif font-bold leading-none">
                      {item.day}
                    </span>
                    <span class="text-[10px] sm:text-xs font-bold tracking-wider uppercase mt-0.5">
                      {item.month}
                    </span>
                  </div>

                  <!-- News Title -->
                  <h3 class="font-serif font-bold text-sm sm:text-base text-brand-charcoal leading-snug group-hover:text-brand-burgundy transition-colors">
                    {item.title}
                  </h3>
                </div>

                <!-- Read More Link -->
                <div class="pt-2 border-t border-brand-charcoal/10 flex justify-end">
                  <a
                    href={item.href}
                    class="text-xs sm:text-sm font-bold tracking-wider text-brand-burgundy uppercase inline-flex items-center gap-1.5 hover:underline focus-visible:ring-2 focus-visible:ring-brand-burgundy rounded"
                  >
                    VER MÁS
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Right Column: Upcoming Events Calendar Card (5 cols) matching height -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col h-full">
        <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-lg border border-brand-sand/60 h-full flex flex-col justify-between">
          
          <!-- Calendar Header -->
          <div class="flex items-center justify-between pb-3.5 border-b border-brand-charcoal/15 mb-3 sm:mb-4 flex-shrink-0">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-full bg-brand-cream flex items-center justify-center text-brand-burgundy flex-shrink-0">
                <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
              </div>
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal">
                Próximo evento
              </h3>
            </div>

            <a
              href="#calendario"
              class="text-xs sm:text-sm font-semibold text-brand-burgundy hover:underline inline-flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-brand-burgundy rounded"
            >
              Ver calendario
            </a>
          </div>

          <!-- Events Rows (3 rows evenly filling the full card height) -->
          <div class="flex flex-col justify-between flex-1 gap-2.5 sm:gap-3">
            {upcomingEvents.map((evt) => (
              <div class="flex items-center justify-between gap-3 p-3 sm:p-3.5 rounded-xl bg-brand-cream/60 hover:bg-brand-cream transition-colors border border-brand-sand/40 flex-1 min-h-0">
                <!-- Date Pill -->
                <div class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-brand-burgundy text-white text-xs sm:text-sm font-bold tracking-tight whitespace-nowrap flex-shrink-0 shadow-sm text-center">
                  {evt.date}
                </div>

                <!-- Event Details -->
                <div class="flex-1 min-w-0 px-1 sm:px-2">
                  <p class="text-xs sm:text-sm font-serif font-bold text-brand-charcoal truncate">
                    {evt.title}
                  </p>
                  <p class="text-xs sm:text-sm text-brand-charcoal-dark font-sans mt-0.5">
                    {evt.time}
                  </p>
                </div>

                <!-- Arrow Icon -->
                <div class="text-brand-burgundy flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
