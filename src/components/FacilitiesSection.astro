---
import { Image } from 'astro:assets';
import campusImg from '../assets/images/campus_fachada.webp';
import treeImg from '../assets/images/arbol_campus.webp';
import studentImg from '../assets/images/imagen1_referencial.avif';
import florSvg from '../assets/FLOR-BEIGE.svg';

const facilities = [
  {
    name: 'ESPACIOS VERDES',
    description: 'Áreas naturales y recreativas para el bienestar integral',
    image: treeImg,
  },
  {
    name: 'AULAS',
    description: 'Ambientes pedagógicos interactivos y climatizados',
    image: studentImg,
  },
  {
    name: 'LABORATORIO',
    description: 'Equipamiento de vanguardia para ciencias y tecnología',
    image: studentImg,
  },
  {
    name: 'CANCHAS',
    description: 'Infraestructura multideportiva de alto rendimiento',
    image: campusImg,
  },
  {
    name: 'PISCINA',
    description: 'Instalaciones acuáticas semiolímpicas y formativas',
    image: campusImg,
  }
];
---

<section id="instalaciones" class="py-12 lg:py-16 xl:py-20 bg-[#454c4e] text-white relative overflow-hidden">
  <!-- Subtle decorative watermark -->
  <div class="absolute -left-12 -bottom-16 w-64 h-auto opacity-10 pointer-events-none select-none">
    <img src={florSvg.src} alt="" class="w-full h-auto object-contain" aria-hidden="true" />
  </div>

  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
      <div class="inline-flex items-center justify-center gap-2 mb-2">
        <img
          src={florSvg.src}
          alt=""
          class="w-5 h-5 object-contain opacity-80"
          aria-hidden="true"
        />
        <span class="text-xs font-bold tracking-[0.25em] text-[#ddd2c6] uppercase font-sans">
          INSTALACIONES
        </span>
      </div>
      <h2 class="text-3xl lg:text-4xl font-serif font-bold text-white mb-3">
        Espacios diseñados para aprender, crear y crecer.
      </h2>
      <p class="text-[#ece7dc]/80 text-sm sm:text-base font-sans font-light">
        Un entorno seguro y moderno que estimula la curiosidad, el deporte y el desarrollo humano.
      </p>
    </div>

    <!-- 5 Stadium/Arch Pill Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-5 xl:gap-6">
      {facilities.map((item) => (
        <div class="group flex flex-col items-center transition-transform duration-300 hover:-translate-y-2">
          <!-- Stadium / Arched Image Container -->
          <div class="w-full h-64 sm:h-72 lg:h-80 xl:h-96 rounded-t-[3.5rem] rounded-b-2xl overflow-hidden shadow-xl border-2 border-white/20 bg-brand-charcoal-dark relative">
            <Image
              src={item.image}
              alt={item.name}
              width={400}
              height={500}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
          </div>

          <!-- Bottom Pill Label -->
          <div class="w-[90%] -mt-6 relative z-10 bg-[#f3f0e8] text-brand-charcoal py-3 px-4 rounded-full text-center shadow-lg border border-white/80 group-hover:bg-white transition-colors">
            <span class="font-serif font-bold text-xs sm:text-sm tracking-widest uppercase block text-brand-charcoal group-hover:text-brand-burgundy transition-colors">
              {item.name}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
