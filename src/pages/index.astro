---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValuesSection from '../components/ValuesSection.astro';
import HistorySection from '../components/HistorySection.astro';
import AcademicPrograms from '../components/AcademicPrograms.astro';
import AdditionalServices from '../components/AdditionalServices.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import NewsEventsSection from '../components/NewsEventsSection.astro';
import AlliancesSection from '../components/AlliancesSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Colegio Pierre de Coubertin | Formación Integral, Valores y Futuro">
  <Header />
  <main class="flex-grow overflow-x-clip">
    <Hero />
    <ValuesSection />
    <HistorySection />
    <AcademicPrograms />
    <AdditionalServices />
    <FacilitiesSection />
    <NewsEventsSection />
    <AlliancesSection />
    <TestimonialsSection />
    <ContactSection />
  </main>
  <Footer />
</Layout>
