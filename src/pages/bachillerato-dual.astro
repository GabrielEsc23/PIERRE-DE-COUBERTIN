---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import florVinoSvg from '../assets/FLOR-CONCHO-VINO.svg';
import florBeigeSvg from '../assets/FLOR-BEIGE.svg';

// Images
import fotoBd from '../assets/images/foto_ejemplo_BD.jpeg';
---

<Layout 
  title="Diploma DUAL: Dos Diplomas, Nuevas Oportunidades | Colegio Pierre de Coubertin"
  description="Programa de Diploma DUAL en alianza con Advantages School International (EE.UU.). Doble titulación: bachiller ecuatoriano y U.S. High School Diploma para estudiantes de Primero de Bachillerato."
>
  <Header />

  <main class="flex-grow overflow-x-clip bg-brand-cream">
    
    <!-- Hero Section -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <!-- Watermark background decoration -->
      <div class="absolute -right-16 -bottom-16 w-64 lg:w-96 h-auto opacity-10 pointer-events-none select-none z-0">
        <img src={florBeigeSvg.src} alt="" class="w-full h-auto object-contain" aria-hidden="true" />
      </div>

      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#oferta-academica" class="hover:text-brand-burgundy transition-colors">Oferta Académica</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Diploma DUAL</span>
          </nav>

          <a 
            href="/#oferta-academica" 
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Oferta Académica</span>
          </a>
        </div>

        <!-- 2 Columns Grid: Left Content & Right Featured Image -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          
          <!-- Left Column: Title and Core Description -->
          <div class="lg:col-span-6 xl:col-span-6 flex flex-col items-start text-left">
            <div class="mb-3">
              <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans">
                PROGRAMA INTERNACIONAL DE DOBLE TITULACIÓN
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              Diploma DUAL: <span class="text-brand-burgundy accent-word-reveal">dos diplomas, nuevas oportunidades</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-6 font-sans">
              En la Institución Educativa Pierre de Coubertin, ampliamos los horizontes académicos de nuestros estudiantes con el programa de Diploma DUAL, dirigido a estudiantes de Primero de Bachillerato, en alianza con <strong>Advantages School International</strong>, una escuela de Estados Unidos.
            </p>

            <!-- Quick Metrics / Highlights -->
            <div class="grid grid-cols-3 gap-3 w-full mb-8">
              <div class="bg-white rounded-2xl p-3.5 sm:p-4 shadow-sm border border-brand-charcoal/10 text-center sm:text-left">
                <span class="block text-brand-burgundy font-serif font-bold text-xl sm:text-2xl leading-none mb-1">2 Títulos</span>
                <span class="font-sans font-bold text-brand-charcoal text-xs sm:text-sm block">Ecuador & EE.UU.</span>
                <span class="text-[11px] text-brand-charcoal-dark block mt-0.5">Doble Validez Oficial</span>
              </div>

              <div class="bg-white rounded-2xl p-3.5 sm:p-4 shadow-sm border border-brand-charcoal/10 text-center sm:text-left">
                <span class="block text-brand-burgundy font-serif font-bold text-xl sm:text-2xl leading-none mb-1">13</span>
                <span class="font-sans font-bold text-brand-charcoal text-xs sm:text-sm block">Estudiantes</span>
                <span class="text-[11px] text-brand-charcoal-dark block mt-0.5">Primera Cohorte 2026</span>
              </div>

              <div class="bg-white rounded-2xl p-3.5 sm:p-4 shadow-sm border border-brand-charcoal/10 text-center sm:text-left">
                <span class="block text-brand-burgundy font-serif font-bold text-xl sm:text-2xl leading-none mb-1">1° BGU</span>
                <span class="font-sans font-bold text-brand-charcoal text-xs sm:text-sm block">Bachillerato</span>
                <span class="text-[11px] text-brand-charcoal-dark block mt-0.5">Inicio del Programa</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href="#alianza-dual"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 group focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
              >
                <span>Conocer el programa</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>

              <a
                href="/admisiones"
                class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base hover:bg-white/80 transition-all duration-200 shadow-sm"
              >
                <span>Admisiones y Consultas</span>
              </a>
            </div>

          </div>

          <!-- Right Column: Featured Image with Decorative Frame -->
          <div class="lg:col-span-6 xl:col-span-6 w-full">
            <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border-4 sm:border-6 border-white/90 group bg-brand-sand">
              <Image
                src={fotoBd}
                alt="Estudiantes del programa Diploma DUAL en el Colegio Pierre de Coubertin"
                width={1200}
                height={800}
                class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]"
                loading="eager"
              />
              <!-- Subtle badge on image -->
              <div class="absolute bottom-4 left-4 right-4 sm:left-6 sm:right-auto bg-brand-charcoal-dark/85 backdrop-blur-md text-white px-4 py-2.5 rounded-xl border border-white/20 shadow-lg max-w-sm">
                <div class="flex items-center gap-2 mb-1">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-[11px] font-bold tracking-wider uppercase text-brand-sand">Alianza Internacional</span>
                </div>
                <p class="text-xs sm:text-sm font-medium leading-snug">
                  En convenio con Advantages School International (Estados Unidos).
                </p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Doble Titulación & Alianza Section -->
    <section id="alianza-dual" class="py-14 lg:py-20 bg-brand-sand relative overflow-hidden section-border-bottom">
      <div class="section-gradient-right" aria-hidden="true"></div>

      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            DOBLE ACREDITACIÓN SIMULTÁNEA
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Dos títulos oficiales al graduarse
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed">
            Este programa ofrece la oportunidad de obtener el título de bachiller ecuatoriano y el diploma de secundaria estadounidense, al cumplir los requisitos académicos de ambas instituciones.
          </p>
        </div>

        <!-- 2 Diplomas Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 max-w-5xl mx-auto mb-12">
          
          <!-- Diploma 1: Ecuador -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 lg:p-9 shadow-lg hover:shadow-2xl transition-all duration-300 border-t-4 border-brand-charcoal flex flex-col justify-between reveal-on-scroll"
            data-animate="animate__fadeInUp"
            data-delay="100ms"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-sand/60 text-brand-charcoal-dark">
                  República del Ecuador
                </span>
                <span class="text-xs text-brand-charcoal/60 font-semibold font-sans">
                  Currículo Nacional
                </span>
              </div>

              <div class="w-14 h-14 rounded-2xl bg-brand-sand/50 text-brand-burgundy flex items-center justify-center mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
                </svg>
              </div>

              <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-3">
                Título de Bachiller Ecuatoriano
              </h3>

              <p class="text-brand-charcoal-dark text-sm sm:text-base leading-relaxed mb-6 font-sans">
                Otorgado por el Ministerio de Educación del Ecuador a través de la Unidad Educativa Pierre de Coubertin, garantizando la sólida base científica, humanista y en valores propia de nuestro modelo formativo.
              </p>

              <ul class="space-y-2.5 mb-6 text-xs sm:text-sm text-brand-charcoal font-medium">
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 text-brand-burgundy flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Cumplimiento riguroso del pénsum curricular ecuatoriano.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 text-brand-burgundy flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Habilitación directa para postular a universidades públicas y privadas del Ecuador.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4 border-t border-brand-charcoal/10 text-xs text-brand-charcoal/70 flex items-center justify-between">
              <span class="font-semibold text-brand-charcoal-dark">Acreditación Nacional</span>
              <span>U.E. Pierre de Coubertin</span>
            </div>
          </div>

          <!-- Diploma 2: Estados Unidos -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 lg:p-9 shadow-lg hover:shadow-2xl transition-all duration-300 border-t-4 border-brand-burgundy flex flex-col justify-between reveal-on-scroll"
            data-animate="animate__fadeInUp"
            data-delay="200ms"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-burgundy/10 text-brand-burgundy">
                  United States of America
                </span>
                <span class="text-xs text-brand-burgundy font-semibold font-sans">
                  Advantages School Intl.
                </span>
              </div>

              <div class="w-14 h-14 rounded-2xl bg-brand-burgundy/10 text-brand-burgundy flex items-center justify-center mb-5">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A48.42 48.42 0 0012 9.75c-2.551 0-5.056.2-7.5.583V21" />
                </svg>
              </div>

              <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-3">
                U.S. High School Diploma
              </h3>

              <p class="text-brand-charcoal-dark text-sm sm:text-base leading-relaxed mb-6 font-sans">
                Emitido por <strong>Advantages School International</strong>, escuela debidamente acreditada en los Estados Unidos, con el mismo valor académico y legal que el de un graduado presencial en el sistema estadounidense.
              </p>

              <ul class="space-y-2.5 mb-6 text-xs sm:text-sm text-brand-charcoal font-medium">
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 text-brand-burgundy flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Convalidación de materias cursadas en Ecuador + asignaturas complementarias en EE.UU.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 text-brand-burgundy flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Reconocimiento por universidades de Estados Unidos, Canadá, Europa y América Latina.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4 border-t border-brand-charcoal/10 text-xs text-brand-charcoal/70 flex items-center justify-between">
              <span class="font-semibold text-brand-burgundy">Acreditación EE.UU.</span>
              <span>Ventaja Global</span>
            </div>
          </div>

        </div>

        <!-- Hito Institucional: Primera Cohorte 2026 -->
        <div class="max-w-4xl mx-auto bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl border border-white/90 relative overflow-hidden reveal-on-scroll" data-animate="animate__fadeInUp">
          <div class="flex flex-col md:flex-row items-center gap-6 sm:gap-8">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-brand-burgundy text-white flex flex-col items-center justify-center flex-shrink-0 shadow-lg border-4 border-brand-cream">
              <span class="font-serif font-bold text-3xl sm:text-4xl leading-none">13</span>
              <span class="text-[10px] sm:text-[11px] font-sans font-bold uppercase tracking-wider text-brand-sand mt-0.5">Estudiantes</span>
            </div>

            <div class="text-center md:text-left">
              <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-burgundy/10 text-brand-burgundy mb-2">
                Hito Institucional Pierre de Coubertin
              </div>
              <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-2">
                Primera Cohorte 2026 en marcha
              </h3>
              <p class="text-brand-charcoal-dark text-sm sm:text-base leading-relaxed font-sans">
                Nuestra primera cohorte 2026 está conformada por 13 estudiantes, quienes inician este camino de formación internacional. Su esfuerzo y dedicación representan el compromiso de nuestra institución por abrir puertas a una educación global y transformadora.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Beneficios Principales Section (4 Pilares) -->
    <section class="py-14 lg:py-20 bg-brand-beige relative overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            VALOR AGREGADO
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Beneficios del <span class="text-brand-burgundy">Diploma DUAL</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed font-sans">
            Entre sus principales beneficios se encuentran el fortalecimiento del inglés en contextos académicos, la experiencia de estudiar dentro de un sistema educativo estadounidense y el desarrollo de habilidades integrales para el futuro.
          </p>
        </div>

        <!-- 4 Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
          
          <!-- Benefit 1: Fortalecimiento del Inglés -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-white/80 reveal-on-scroll flex items-start gap-4 sm:gap-5"
            data-animate="animate__fadeInUp"
            data-delay="100ms"
          >
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-sand/60 text-brand-burgundy flex items-center justify-center flex-shrink-0 shadow-inner mt-1">
              <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">
                Inglés en Contextos Académicos
              </h3>
              <p class="text-sm text-brand-charcoal-dark font-sans leading-relaxed">
                Inmersión lingüística auténtica donde el idioma se utiliza como herramienta de estudio, redacción de ensayos, análisis y evaluación de materias curriculares avanzadas.
              </p>
            </div>
          </div>

          <!-- Benefit 2: Sistema Educativo Estadounidense -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-white/80 reveal-on-scroll flex items-start gap-4 sm:gap-5"
            data-animate="animate__fadeInUp"
            data-delay="200ms"
          >
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-sand/60 text-brand-burgundy flex items-center justify-center flex-shrink-0 shadow-inner mt-1">
              <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">
                Sistema Educativo Estadounidense
              </h3>
              <p class="text-sm text-brand-charcoal-dark font-sans leading-relaxed">
                Experiencia formativa directa dentro de la estructura académica de EE.UU., asimilando sus criterios de evaluación, pensamiento crítico y metodologías pedagógicas.
              </p>
            </div>
          </div>

          <!-- Benefit 3: Habilidades para la Vida -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-white/80 reveal-on-scroll flex items-start gap-4 sm:gap-5"
            data-animate="animate__fadeInUp"
            data-delay="300ms"
          >
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-sand/60 text-brand-burgundy flex items-center justify-center flex-shrink-0 shadow-inner mt-1">
              <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">
                Autonomía y Competencias Digitales
              </h3>
              <p class="text-sm text-brand-charcoal-dark font-sans leading-relaxed">
                Desarrollo probado de autonomía personal, responsabilidad, autogestión y organización del tiempo, complementado con el dominio de herramientas tecnológicas y entornos virtuales.
              </p>
            </div>
          </div>

          <!-- Benefit 4: Perfil Preuniversitario Exterior -->
          <div 
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-white/80 reveal-on-scroll flex items-start gap-4 sm:gap-5"
            data-animate="animate__fadeInUp"
            data-delay="400ms"
          >
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-sand/60 text-brand-burgundy flex items-center justify-center flex-shrink-0 shadow-inner mt-1">
              <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">
                Opciones de Educación Superior en el Exterior
              </h3>
              <p class="text-sm text-brand-charcoal-dark font-sans leading-relaxed">
                Enriquecimiento del perfil académico de los estudiantes, diferenciándolos notablemente al postular a universidades prestigiosas y becas internacionales fuera del país.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>

