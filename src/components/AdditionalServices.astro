---
import { Image } from 'astro:assets';
import cardImg from '../assets/images/imagen1_referencial.avif';

const services = [
  {
    title: 'CERTIFICACIÓN EN INGLES',
    subtitle: 'Nivel internacional avalado',
    image: cardImg,
    href: '#ingles'
  },
  {
    title: 'SCOUTS',
    subtitle: 'Liderazgo, valores y aire libre',
    image: cardImg,
    href: '#scouts'
  },
  {
    title: 'REFRIGERIO ESCOLAR',
    subtitle: 'Nutrición balanceada y saludable',
    image: cardImg,
    href: '#refrigerio'
  },
  {
    title: 'TRANSPORTE',
    subtitle: 'Rutas seguras y monitoreadas',
    image: cardImg,
    href: '#transporte'
  },
  {
    title: 'ACTIVIDADES EXTRACURRICULARES',
    subtitle: 'Deporte, arte y tecnología',
    image: cardImg,
    href: '#extracurriculares'
  }
];
---

<section id="servicios-adicionales" class="py-12 lg:py-16 xl:py-20 bg-[#ece7dc] relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <!-- Section Header Pill Banner -->
    <div class="flex justify-center mb-10 lg:mb-12">
      <div class="inline-flex flex-col items-center justify-center bg-brand-burgundy text-white px-8 sm:px-12 py-3.5 rounded-full shadow-lg text-center">
        <span class="text-[11px] sm:text-xs font-bold tracking-widest uppercase opacity-90">
          SERVICIOS ADICIONALES
        </span>
        <span class="text-sm sm:text-base font-serif font-medium mt-0.5 tracking-wide">
          Más que educación, es una experiencia de vida
        </span>
      </div>
    </div>

    <!-- 5 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-5 xl:gap-6">
      {services.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 bg-white border border-white/70"
        >
          <!-- Arched Card Image Top -->
          <div class="h-44 sm:h-48 w-full overflow-hidden bg-brand-sand">
            <Image
              src={item.image}
              alt={item.title}
              width={400}
              height={320}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Card Content Bottom -->
          <div class="p-4 sm:p-5 flex flex-col items-center justify-center text-center flex-1">
            <h3 class="font-serif font-bold text-sm sm:text-base text-brand-charcoal uppercase tracking-wider leading-snug group-hover:text-brand-burgundy transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-brand-charcoal/70 font-sans mt-1">
              {item.subtitle}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
