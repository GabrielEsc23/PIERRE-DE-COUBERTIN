---

<Layout
  title="Refrigerio Escolar y Menú Semanal | Colegio Pierre de Coubertin"
  description="Menú escolar semanal de lunes a viernes en el Colegio Pierre de Coubertin: refrigerio de media mañana y almuerzo con ingredientes frescos y opciones para alergias."
>
  <Header />

  <main class="flex-grow overflow-x-hidden bg-brand-cream">

    <!-- Hero -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">

        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#servicios-adicionales" class="hover:text-brand-burgundy transition-colors">Servicios Adicionales</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Refrigerio escolar</span>
          </nav>

          <a
            href="/#servicios-adicionales"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Servicios</span>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans mb-3">
              Nutrición y bienestar
            </span>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              Refrigerio y almuerzo: <span class="text-brand-burgundy">nutrición balanceada para crecer</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-8 font-sans">
              Platos preparados cada día con ingredientes frescos y supervisados por profesionales en nutrición infantil, para que tus hijos tengan energía durante toda la jornada.
            </p>

            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8">
              <a
                href="#menu-mensual"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors group"
              >
                <span>Ver el menú</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>
              <a
                href="#planes"
                class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
              >
                <span>Ver planes</span>
              </a>
            </div>

            <dl class="flex flex-wrap gap-x-10 gap-y-4 pt-6 border-t border-brand-charcoal/10 w-full">
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Refrigerio</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">10:00 – 10:30</dd>
              </div>
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Almuerzo</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">12:30 – 13:30</dd>
              </div>
            </dl>
          </div>

          <div class="lg:col-span-6 w-full">
            <img
              src="https://images.unsplash.com/photo-1551218372-a8789b81b253?auto=format&fit=crop&w=1200&q=80"
              alt="Almuerzo saludable servido en el comedor escolar"
              class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center rounded-3xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Filosofía nutricional: 3 puntos breves -->
    <section class="py-14 lg:py-20 bg-brand-sand relative overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Filosofía nutricional
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal">
            Alimentación pensada para aprender mejor
          </h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 max-w-6xl mx-auto">
          {pillars.map((pillar, idx) => (
            <li class="border-t-2 border-brand-burgundy pt-6 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay={`${(idx + 1) * 100}ms`}>
              <span class="block font-serif font-bold text-3xl text-brand-burgundy mb-4" aria-hidden="true">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <h3 class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mb-2">{pillar.title}</h3>
              <p class="text-base text-brand-charcoal-dark font-sans leading-relaxed">{pillar.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Menú semanal -->
    <section id="menu-mensual" class="py-14 lg:py-20 bg-brand-beige relative section-border-bottom print-area scroll-mt-4">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">

        <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Menú semanal
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            ¿Qué comen esta semana?
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg font-medium leading-relaxed font-sans">
            Un ciclo de 4 semanas que se repite durante el año lectivo. Puede variar ligeramente según la fruta de temporada.
          </p>
        </div>

        <!-- Selector de semana + imprimir -->
        <div class="max-w-6xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-4 no-print">
          <div role="tablist" aria-label="Semana del ciclo" class="grid grid-cols-4 w-full sm:w-auto sm:inline-grid rounded-full bg-white border border-brand-charcoal/10 p-1">
            {menuData.map((week, idx) => (
              <button
                type="button"
                role="tab"
                id={`tab-${week.weekId}`}
                aria-controls={`panel-${week.weekId}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                tabindex={idx === 0 ? 0 : -1}
                class="week-tab min-h-10 px-3 sm:px-5 rounded-full text-sm font-bold whitespace-nowrap text-brand-charcoal hover:text-brand-burgundy transition-colors cursor-pointer aria-selected:bg-brand-burgundy aria-selected:text-white aria-selected:hover:text-white"
              >
                {week.weekTitle}
              </button>
            ))}
          </div>

          <button
            type="button"
            id="btn-print-menu"
            class="min-h-10 text-sm font-bold text-brand-burgundy underline-offset-4 hover:underline cursor-pointer"
          >
            Imprimir menú
          </button>
        </div>

        <div class="max-w-6xl mx-auto">
          {menuData.map((week, weekIdx) => (
            <div
              id={`panel-${week.weekId}`}
              role="tabpanel"
              aria-labelledby={`tab-${week.weekId}`}
              class="week-panel"
              hidden={weekIdx !== 0}
            >
              <!-- Escritorio: tabla -->
              <div class="hidden lg:block print:block overflow-hidden rounded-3xl bg-white border border-brand-charcoal/10">
                <!-- Cabecera de la semana con la rama como detalle de marca -->
                <div class="relative overflow-hidden flex items-baseline gap-3 px-6 py-5 bg-brand-burgundy text-white">
                  <span class="font-serif font-bold text-xl xl:text-2xl">{week.weekTitle}</span>
                  <span class="text-sm xl:text-base text-[#ead9c8]">{week.theme}</span>
                  <img
                    src={florBeige.src}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="no-print absolute -right-4 -top-16 w-28 h-auto opacity-25 pointer-events-none select-none rotate-[70deg]"
                  />
                </div>
                <table class="w-full table-fixed border-collapse text-left font-sans">
                  <caption class="sr-only">Menú de la {week.weekTitle.toLowerCase()}, de lunes a viernes</caption>
                  <colgroup>
                    <col class="w-44 xl:w-48" />
                    {week.days.map(() => <col />)}
                  </colgroup>
                  <thead>
                    <tr class="border-b-2 border-brand-burgundy">
                      <th scope="col" class="p-5 bg-brand-cream/60"><span class="sr-only">Tiempo de comida</span></th>
                      {week.days.map((dayItem, dIdx) => (
                        <th scope="col" class="day-col p-5 align-bottom transition-colors" data-day-col={dIdx}>
                          <span class="today-label hidden text-xs font-bold uppercase tracking-[0.2em] text-brand-burgundy mb-1">Hoy</span>
                          <span class="block font-serif font-bold text-lg xl:text-xl text-brand-charcoal">{dayItem.day}</span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-brand-charcoal/10">
                    {meals.map((meal) => (
                      <>
                      {meal.group && (
                        <tr class="bg-brand-sand/70">
                          <th scope="colgroup" colspan={week.days.length + 1} class="px-5 py-2.5 text-left">
                            <span class="text-sm font-bold text-brand-charcoal">{meal.group.name}</span>
                            <span class="text-sm text-brand-charcoal/70"> · {meal.group.time}</span>
                          </th>
                        </tr>
                      )}
                      <tr>
                        <th scope="row" class="p-5 align-top bg-brand-cream/60">
                          <span class="block text-xs font-bold uppercase tracking-[0.16em] text-brand-burgundy">{meal.label}</span>
                        </th>
                        {week.days.map((dayItem, dIdx) => (
                          <td
                            class:list={[
                              'day-col p-5 align-top text-[15px] leading-relaxed text-brand-charcoal-dark transition-colors',
                              meal.strong && 'font-semibold text-brand-charcoal',
                            ]}
                            data-day-col={dIdx}
                          >
                            {(dayItem as Day)[meal.key]}
                          </td>
                        ))}
                      </tr>
                      </>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- Móvil y tablet: una tarjeta por día -->
              <div class="lg:hidden print:hidden grid grid-cols-1 md:grid-cols-2 gap-4">
                {week.days.map((dayItem, dIdx) => (
                  <article class="day-card rounded-3xl bg-white border border-brand-charcoal/10 p-6" data-day-col={dIdx}>
                    <h3 class="flex items-baseline justify-between gap-3 font-serif font-bold text-xl text-brand-burgundy pb-4 mb-1 border-b-2 border-brand-burgundy">
                      {dayItem.day}
                      <span class="today-label hidden text-xs font-sans font-bold uppercase tracking-[0.2em] text-brand-burgundy">Hoy</span>
                    </h3>
                    <dl class="divide-y divide-brand-charcoal/10">
                      {meals.map((meal) => (
                        <div class="py-3">
                          <dt>
                            {meal.group && (
                              <span class="block -mx-6 mb-3 px-6 py-2 bg-brand-sand/70 text-sm">
                                <span class="font-bold text-brand-charcoal">{meal.group.name}</span>
                                <span class="text-brand-charcoal/70"> · {meal.group.time}</span>
                              </span>
                            )}
                            <span class="block text-xs font-bold uppercase tracking-[0.16em] text-brand-burgundy">{meal.label}</span>
                          </dt>
                          <dd class:list={['mt-1 text-base leading-relaxed text-brand-charcoal-dark', meal.strong && 'font-semibold text-brand-charcoal']}>
                            {(dayItem as Day)[meal.key]}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Planes -->
    <section id="planes" class="py-14 lg:py-20 bg-brand-cream relative section-border-bottom scroll-mt-4">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Modalidades y costos
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal">
            Planes adaptados a tu familia
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
          {plans.map((plan, idx) => (
            <article
              class:list={[
                'bg-white rounded-3xl p-6 sm:p-8 flex flex-col reveal-on-scroll',
                plan.featured ? 'border-2 border-brand-burgundy' : 'border border-brand-charcoal/10',
              ]}
              data-animate="animate__fadeInUp"
              data-delay={`${(idx + 1) * 100}ms`}
            >
              <span class:list={['text-xs font-bold uppercase tracking-[0.2em] mb-2', plan.featured ? 'text-brand-burgundy' : 'text-brand-charcoal/70']}>
                {plan.label}
              </span>
              <h3 class="font-serif font-bold text-2xl text-brand-charcoal mb-4">{plan.title}</h3>
              <p class="flex items-baseline gap-1.5 mb-2">
                <span class="font-serif font-bold text-4xl text-brand-charcoal">{plan.price}</span>
                {plan.unit && <span class="text-base text-brand-charcoal-dark">{plan.unit}</span>}
              </p>
              <p class="text-sm sm:text-base text-brand-charcoal-dark leading-relaxed mb-6">{plan.text}</p>
              <ul class="border-t border-brand-charcoal/10 divide-y divide-brand-charcoal/10 text-sm sm:text-base text-brand-charcoal-dark mb-8">
                {plan.items.map((item) => <li class="py-3">{item}</li>)}
              </ul>
              <a
                href={plan.cta.href}
                class:list={[
                  'mt-auto w-full inline-flex items-center justify-center min-h-12 rounded-full font-bold text-sm sm:text-base transition-colors',
                  plan.featured
                    ? 'bg-brand-burgundy text-white hover:bg-brand-burgundy-dark'
                    : 'bg-white text-brand-charcoal border border-brand-charcoal/20 hover:text-brand-burgundy hover:border-brand-burgundy',
                ]}
              >
                {plan.cta.label}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-16 bg-brand-cream relative">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl text-brand-charcoal mb-4">
          ¿Quieres contratar el servicio de comedor?
        </h2>
        <p class="text-brand-charcoal-dark text-base sm:text-lg max-w-2xl mx-auto mb-8 font-sans">
          Actívalo durante la matrícula o escríbenos para registrar requerimientos nutricionales especiales.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/admisiones"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors"
          >
            <span>Iniciar proceso de admisión</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/#contactos"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
          >
            <span>Consultar con nutrición escolar</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  @media print {
    header, footer, nav, .no-print {
      display: none !important;
    }
    main > section:not(.print-area) {
      display: none !important;
    }
    body, main, section {
      background: white !important;
      color: black !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .print-area {
      display: block !important;
      padding: 10px !important;
    }
    table {
      font-size: 10pt !important;
    }
    th, td {
      border: 1px solid #ddd !important;
      padding: 6px 8px !important;
      background: white !important;
    }
  }
</style>

<script>
  function setupWeeklyMenu() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.week-tab'));
    const panels = document.querySelectorAll<HTMLElement>('.week-panel');
    if (!tabs.length) return;

    // Resaltar el día actual (lunes = 0 … viernes = 4)
    const today = new Date().getDay();
    if (today >= 1 && today <= 5) {
      const idx = String(today - 1);
      document.querySelectorAll<HTMLElement>(`.day-col[data-day-col="${idx}"]`).forEach((cell) => {
        cell.classList.add('bg-brand-cream');
      });
      document.querySelectorAll<HTMLElement>(`[data-day-col="${idx}"] .today-label, .day-col[data-day-col="${idx}"] .today-label`).forEach((label) => {
        label.classList.remove('hidden');
        label.classList.add('block');
      });
      document.querySelectorAll<HTMLElement>(`.day-card[data-day-col="${idx}"]`).forEach((card) => {
        card.classList.add('ring-2', 'ring-brand-burgundy');
      });
    }

    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      const target = tab.getAttribute('aria-controls');
      panels.forEach((panel) => {
        panel.hidden = panel.id !== target;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = tabs[(i + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        selectTab(next);
        next.focus();
      });
    });

    document.getElementById('btn-print-menu')?.addEventListener('click', () => window.print());
  }

  setupWeeklyMenu();
</script>
