---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import florVino from '../assets/flor-concho-vino.webp';

// Images & Logos
import scoutsLogo from '../assets/images/alliances/scouts.png';
import scoutPortada from '../assets/images/Scout-portada.png';
import campusVerde from '../assets/images/AREA_VERDE_1.jpg';
---

<Layout 
  title="Movimiento Scout: Liderazgo, Valores y Aire Libre | Colegio Pierre de Coubertin"
  description="Grupo Scout de la Institución Educativa Pierre de Coubertin en alianza con Scouts del Ecuador. Formación del carácter, campismo, trabajo en equipo y servicio a la comunidad."
>
  <Header />

  <main class="flex-grow overflow-x-hidden bg-brand-cream">
    
    <!-- Hero Section -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#servicios-adicionales" class="hover:text-brand-burgundy transition-colors">Servicios Adicionales</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Movimiento Scout</span>
          </nav>

          <a 
            href="/#servicios-adicionales" 
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Servicios</span>
          </a>
        </div>

        <!-- 2 Columns Grid: Left Information & Right Main Image -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          
          <!-- Left Column: Title and Core Description -->
          <div class="lg:col-span-6 xl:col-span-6 flex flex-col items-start text-left">
            <div class="mb-3">
              <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans">
                FORMACIÓN EN VALORES & AIRE LIBRE
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              Movimiento Scout: <span class="text-brand-burgundy">liderazgo, carácter y naturaleza</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-8 font-sans">
              En la Institución Educativa Pierre de Coubertin promovemos el Movimiento Scout como un pilar fundamental en la formación integral de nuestros estudiantes, fomentando valores, habilidades y principios que contribuyen a su desarrollo personal y social. A través de la aventura al aire libre, el sistema de patrullas, la vivencia de principios éticos y el servicio comunitario, impulsamos la formación de jóvenes autónomos, solidarios, responsables y comprometidos con el cuidado del medio ambiente.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href="#caminantes"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 group focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
              >
                <span>Conocer el programa</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>

              <a
                href="/admisiones"
                class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base hover:bg-white/80 transition-all duration-200 shadow-sm"
              >
                <span>Inscripciones y Admisiones</span>
              </a>
            </div>

          </div>

          <!-- Right Column: Featured Image with Decorative Frame -->
          <div class="lg:col-span-6 xl:col-span-6 w-full">
            <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border-4 sm:border-6 border-white/90 group bg-brand-sand">
              <Image
                src={scoutPortada}
                alt="Jóvenes scouts reunidos al aire libre desarrollando liderazgo y fraternidad"
                width={1200}
                height={800}
                class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]"
                loading="eager"
              />
              
              <!-- Floating badge with Scouts Logo -->
              <div class="absolute bottom-4 left-4 right-4 sm:left-6 sm:right-auto bg-brand-charcoal-dark/90 backdrop-blur-md text-white p-3 sm:p-4 rounded-2xl border border-white/20 shadow-xl max-w-sm flex items-center gap-3.5">
                <div class="w-12 h-12 bg-white rounded-xl p-1.5 flex items-center justify-center flex-shrink-0 shadow-sm">
                  <Image
                    src={scoutsLogo}
                    alt="Logo Scouts del Ecuador"
                    class="h-9 w-auto object-contain"
                    loading="eager"
                  />
                </div>
                <div>
                  <div class="flex items-center gap-1.5 mb-0.5">
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span class="text-[10px] font-bold tracking-wider uppercase text-brand-sand">Alianza Institucional</span>
                  </div>
                  <p class="text-xs sm:text-sm font-medium leading-snug text-white/95">
                    Miembros de la Asociación de Scouts del Ecuador y la OMMS.
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Alianza Oficial & Método Scout Section -->
    <section id="alianza-scout" class="py-14 lg:py-20 bg-brand-sand relative overflow-hidden section-border-bottom">
      <div class="section-gradient-right" aria-hidden="true"></div>

      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            MÉTODO SCOUT INTERNACIONAL
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Aprender haciendo: educación en valores para transformar el mundo
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed">
            El Escultismo es el movimiento juvenil más grande del planeta. En Pierre de Coubertin lo adaptamos a nuestro proyecto educativo para formar personas íntegras, seguras de sí mismas y útiles para su patria.
          </p>
        </div>

        <!-- 2 Cards: Alianza ASE & Ley Scout (mismo tratamiento, sin íconos) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto mb-12">

          <!-- Card 1: Alianza Scouts del Ecuador -->
          <article
            class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-brand-charcoal/10 flex flex-col reveal-on-scroll"
            data-animate="animate__fadeInUp"
            data-delay="100ms"
          >
            <div class="h-24 sm:h-28 flex items-center mb-8">
              <Image
                src={scoutsLogo}
                alt="Asociación de Scouts del Ecuador"
                class="h-20 sm:h-24 w-auto object-contain"
                loading="lazy"
              />
            </div>

            <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-brand-burgundy uppercase font-sans block mb-2">
              Respaldo oficial
            </span>
            <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-4">
              Asociación de Scouts del Ecuador
            </h3>
            <p class="text-brand-charcoal-dark text-base leading-relaxed mb-6 font-sans">
              Nuestro grupo opera con el aval, registro formal y protocolos de seguridad de la Asociación de Scouts del Ecuador, miembro de la Organización Mundial del Movimiento Scout. Los estudiantes acceden a una progresión estructurada con insignias de especialidad, pañolón institucional y carné scout con validez nacional e internacional.
            </p>

            <ul class="mt-auto border-t border-brand-charcoal/10 divide-y divide-brand-charcoal/10 text-sm sm:text-base text-brand-charcoal-dark font-sans leading-relaxed">
              <li class="py-3">Dirigentes calificados y certificados bajo los estándares de educación no formal de la ASE.</li>
              <li class="py-3">Seguro de accidentes vigente para todas las salidas de campo y campamentos.</li>
              <li class="pt-3">Intercambio con otros grupos scouts en fogatas, jamborees y eventos distritales.</li>
            </ul>
          </article>

          <!-- Card 2: La Ley y Promesa Scout -->
          <article
            class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-brand-charcoal/10 flex flex-col relative overflow-hidden reveal-on-scroll"
            data-animate="animate__fadeInUp"
            data-delay="200ms"
          >
            <!-- Rama de laurel: único detalle de marca de la página -->
            <img
              src={florVino.src}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class="absolute -right-10 -bottom-12 w-40 sm:w-48 h-auto opacity-[0.12] pointer-events-none select-none rotate-[18deg]"
            />

            <div class="h-24 sm:h-28 flex items-end gap-3 mb-8 relative">
              <span class="font-serif font-bold text-7xl sm:text-8xl text-brand-burgundy leading-[0.8] tracking-tight">10</span>
              <span class="text-sm sm:text-base font-semibold text-brand-charcoal leading-tight pb-1">principios<br />de vida</span>
            </div>

            <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-brand-burgundy uppercase font-sans block mb-2 relative">
              Marco ético
            </span>
            <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-4 relative">
              La Ley Scout: un código de honor
            </h3>
            <p class="text-brand-charcoal-dark text-base leading-relaxed mb-6 font-sans relative">
              La Promesa y la Ley Scout orientan las decisiones diarias de los estudiantes. Más allá de una actividad de fin de semana, constituyen una filosofía práctica donde la honradez, la solidaridad, el optimismo y el respeto por los seres vivos se convierten en hábitos perdurables.
            </p>

            <ul class="mt-auto border-t border-brand-charcoal/10 divide-y divide-brand-charcoal/10 text-sm sm:text-base text-brand-charcoal-dark font-sans leading-relaxed relative">
              <li class="py-3"><strong class="text-brand-charcoal">Compromiso voluntario</strong> — la promesa asumida libremente como pacto con uno mismo.</li>
              <li class="py-3"><strong class="text-brand-charcoal">Acción diaria</strong> — la práctica constante de la «buena acción cotidiana».</li>
              <li class="pt-3"><strong class="text-brand-charcoal">Conciencia ecológica</strong> — cuidado activo del agua, la flora, la fauna y el entorno escolar.</li>
            </ul>
          </article>

        </div>

      </div>
    </section>

    <!-- Rama Caminantes: única rama del grupo -->
    <section id="caminantes" class="py-14 lg:py-20 bg-brand-beige relative overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">

        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            NUESTRA RAMA
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Caminantes: <span class="text-brand-burgundy">protagonistas de su propio crecimiento</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed font-sans">
            Nuestro grupo trabaja exclusivamente con la rama de Caminantes: jóvenes capaces de identificar necesidades de su entorno y transformarlas en iniciativas que generen un impacto positivo en la comunidad.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 max-w-6xl mx-auto">

          <!-- Caminantes: descripción y competencias -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-md border border-white/80 reveal-on-scroll" data-animate="animate__fadeInUp">
            <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-4">
              Proyectos propios, impacto real
            </h3>
            <p class="text-brand-charcoal-dark text-sm sm:text-base leading-relaxed mb-4 font-sans">
              Identifican necesidades de su entorno y las transforman en iniciativas de servicio social, emprendimientos solidarios y proyectos ecológicos. A través de la planificación y ejecución de sus propios proyectos fortalecen competencias clave:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 mb-6 text-sm sm:text-base text-brand-charcoal font-medium">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Liderazgo</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Oratoria y comunicación asertiva</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Resolución de conflictos</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Toma de decisiones</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Gestión de proyectos</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-burgundy flex-shrink-0"></span><span>Trabajo en equipo</span></li>
            </ul>
            <p class="text-brand-charcoal-dark text-sm sm:text-base leading-relaxed font-sans">
              Asimismo, participan en expediciones, actividades de montaña y experiencias de aventura que fomentan su autonomía, resiliencia y capacidad de superar desafíos. Esta etapa consolida jóvenes comprometidos con la sociedad, conscientes de su responsabilidad ambiental y preparados para asumir nuevos retos académicos, personales y profesionales, proyectándose con seguridad hacia la vida universitaria y su futuro.
            </p>
          </div>

          <!-- Participación Estudiantil -->
          <div class="lg:col-span-5 bg-brand-burgundy text-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-md flex flex-col justify-between gap-6 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay="100ms">
            <div>
              <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-[#f8ebd2] uppercase font-sans block mb-3">
                Convalidación oficial
              </span>
              <h3 class="font-serif font-bold text-2xl sm:text-3xl mb-4">
                Participación Estudiantil
              </h3>
              <p class="text-white/90 text-sm sm:text-base leading-relaxed font-sans">
                Trabajamos articuladamente con el Movimiento Scout como una alternativa para el cumplimiento y la convalidación de la Participación Estudiantil. Nuestros estudiantes desarrollan proyectos de servicio, liderazgo y compromiso social mientras viven experiencias significativas que fortalecen su sentido de pertenencia, trabajo en equipo y vocación de servicio.
              </p>
            </div>
            <p class="pt-4 border-t border-white/20 text-sm sm:text-base font-semibold text-[#f8ebd2]">
              Sábados de 08:00 a 11:00
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- Pilares de la Experiencia Scout (4 Tarjetas) -->
    <section class="py-14 lg:py-20 bg-brand-cream relative overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            BENEFICIOS FORMATIVOS
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Pilares de la experiencia en <span class="text-brand-burgundy">Pierre de Coubertin</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium max-w-2xl mx-auto leading-relaxed font-sans">
            Una propuesta vivencial que complementa la excelencia académica con templanza, espíritu solidario y desconexión tecnológica saludable.
          </p>
        </div>

        <!-- 4 Pilares numerados (sin íconos) -->
        <ol class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto mb-12">
          {[
            {
              title: 'Vida al aire libre y campismo',
              text: 'Aprovechamos las amplias áreas verdes del colegio y organizamos campamentos trimestrales en reservas naturales. Los scouts aprenden a montar sus propias carpas, cocinar al fuego y respetar los ciclos biológicos del entorno.',
            },
            {
              title: 'Liderazgo compartido y trabajo en equipo',
              text: 'Cada integrante asume responsabilidades concretas en su patrulla (secretario, enfermero, intendente, animador). Esto entrena la escucha empática, la toma de decisiones consensuada y la capacidad de responder serenamente ante imprevistos.',
            },
            {
              title: 'Resiliencia y salud emocional',
              text: 'Brindamos una alternativa activa frente al sedentarismo y la sobreexposición a pantallas. Las actividades físicas al aire libre forjan resistencia física, seguridad personal y amistades fraternas de por vida.',
            },
            {
              title: 'Servicio a la comunidad y ecología',
              text: 'Reforestación urbana, recolección benéfica y apoyo a sectores vulnerables. Los estudiantes comprenden que su conocimiento y talento cobran verdadero sentido cuando se ponen al servicio del prójimo.',
            },
          ].map((pillar, idx) => (
            <li
              class="bg-white rounded-3xl p-6 sm:p-8 border border-brand-charcoal/10 reveal-on-scroll flex items-start gap-5 sm:gap-6"
              data-animate="animate__fadeInUp"
              data-delay={`${(idx + 1) * 100}ms`}
            >
              <span class="font-serif font-bold text-3xl sm:text-4xl text-brand-burgundy leading-none flex-shrink-0 w-12" aria-hidden="true">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">
                  {pillar.title}
                </h3>
                <p class="text-sm sm:text-base text-brand-charcoal-dark font-sans leading-relaxed">
                  {pillar.text}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- Practical Details Card (Horario e Inscripción) -->
        <div class="max-w-4xl mx-auto bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl border border-white/90 relative overflow-hidden reveal-on-scroll" data-animate="animate__fadeInUp">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">

            <div class="md:col-span-8">
              <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-burgundy/10 text-brand-burgundy mb-2">
                Información Operativa para Padres
              </div>
              <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-3">
                ¿Cómo funciona el Grupo Scout?
              </h3>

              <div class="space-y-2 text-sm sm:text-base text-brand-charcoal-dark font-sans leading-relaxed">
                <p>
                  <strong>Lugar de reuniones:</strong> Instalaciones y campus verde de la Unidad Educativa Pierre de Coubertin.
                </p>
                <p>
                  <strong>Día y horario de activación:</strong> Sábados de 08:00 a 11:00.
                </p>
                <p>
                  <strong>Rama:</strong> Caminantes.
                </p>
                <p>
                  <strong>Inscripción:</strong> $25 anuales por año calendario, pagados directamente en la Oficina Scout. No hay pensión mensual.
                </p>
                <p>
                  <strong>Beneficio académico:</strong> Convalida la Participación Estudiantil.
                </p>
              </div>
            </div>

            <div class="md:col-span-4 flex flex-col items-center justify-center p-4 bg-brand-sand/40 rounded-2xl border border-brand-charcoal/10 text-center">
              <span class="text-xs uppercase font-bold tracking-wider text-brand-charcoal/70 mb-1">Inscripción anual</span>
              <span class="text-3xl sm:text-4xl font-serif font-bold text-brand-burgundy leading-none mb-1">$25</span>
              <span class="text-xs sm:text-sm text-brand-charcoal-dark font-medium mb-4">Sin pensión mensual</span>
              <a
                href="/#contactos"
                class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-brand-burgundy text-white text-sm font-bold hover:bg-brand-burgundy-dark transition-colors shadow-sm"
              >
                <span>Solicitar información</span>
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Institutional Quote Section (Lema) -->
    <section class="py-14 lg:py-18 bg-brand-burgundy text-white relative overflow-hidden section-border-bottom-dark">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-20 reveal-on-scroll" data-animate="animate__fadeInUp">

        <blockquote class="font-serif italic text-2xl sm:text-3xl md:text-4xl text-white leading-relaxed mb-6 font-bold">
          "Con espíritu de aventura, corazón de servicio y mirada hacia las cumbres del futuro."
        </blockquote>

        <p class="text-brand-cream/80 text-sm sm:text-base font-sans tracking-widest uppercase font-semibold">
          Lema Scout Pierre — Siempre Listos
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-12 lg:py-16 bg-brand-cream relative">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h3 class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl text-brand-charcoal mb-4">
