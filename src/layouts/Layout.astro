---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Colegio Pierre de Coubertin | Formación Integral",
	description = "Colegio Pierre de Coubertin. Formación integral, valores y excelencia académica. Potenciamos el talento y la confianza de cada estudiante para construir un mejor futuro."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-brand-cream text-brand-charcoal min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">
		<slot />
	</body>
</html>
