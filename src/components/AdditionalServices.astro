---
import { Image } from 'astro:assets';
import cardImg from '../assets/images/imagen1_referencial.avif';
import florVinoSvg from '../assets/FLOR-CONCHO-VINO.svg';

const services = [
  {
    title: 'CERTIFICACIÓN EN INGLES',
    subtitle: 'Nivel internacional avalado',
    image: cardImg,
    href: '#ingles'
  },
  {
    title: 'SCOUTS',
    subtitle: 'Liderazgo, valores y aire libre',
    image: cardImg,
    href: '#scouts'
  },
  {
    title: 'REFRIGERIO ESCOLAR',
    subtitle: 'Nutrición balanceada y saludable',
    image: cardImg,
    href: '#refrigerio'
  },
  {
    title: 'TRANSPORTE',
    subtitle: 'Rutas seguras y monitoreadas',
    image: cardImg,
    href: '#transporte'
  },
  {
    title: 'ACTIVIDADES EXTRACURRICULARES',
    subtitle: 'Deporte, arte y tecnología',
    image: cardImg,
    href: '#extracurriculares'
  }
];
---

<section id="servicios-adicionales" class="py-12 lg:py-16 xl:py-20 bg-brand-beige relative overflow-hidden">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <!-- Section Header framed with burgundy feathers (no burgundy background) -->
    <div class="relative max-w-3xl mx-auto text-center mb-8 lg:mb-12 px-4">
      <!-- Left Floral Feather (curves inward toward title) -->
      <div class="hidden sm:block absolute -left-10 md:-left-16 lg:-left-5 top-1/2 -translate-y-1/2 w-16 sm:w-20 lg:w-24 h-auto pointer-events-none select-none opacity-90">
        <img
          src={florVinoSvg.src}
          alt=""
          class="w-full h-auto object-contain"
          aria-hidden="true"
        />
      </div>

      <!-- Right Floral Feather (curves inward toward title) -->
      <div class="hidden sm:block absolute -right-10 md:-right-16 lg:-right-5 top-1/2 -translate-y-1/2 w-16 sm:w-20 lg:w-24 h-auto pointer-events-none select-none opacity-90">
        <img
          src={florVinoSvg.src}
          alt=""
          class="w-full h-auto object-contain -scale-x-100"
          aria-hidden="true"
        />
      </div>

      <div class="flex items-center justify-center gap-3 mb-2">
        <div class="h-px w-8 bg-brand-charcoal/20 hidden sm:block"></div>
        <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans">
          SERVICIOS ADICIONALES
        </span>
        <div class="h-px w-8 bg-brand-charcoal/20 hidden sm:block"></div>
      </div>

      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal leading-tight">
        Más que educación, es una <span class="text-brand-burgundy">experiencia de vida</span>
      </h2>
    </div>

    <!-- 5 Cards Grid (2-col balanced on mobile, 5-col on desktop) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 lg:gap-5 xl:gap-6">
      {services.map((item, index) => (
        <a
          href={item.href}
          class:list={[
            "group flex flex-col rounded-2xl sm:rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 bg-white border border-white/70 focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2",
            index === 4 ? "col-span-2 sm:col-span-1 max-w-[calc(50%-0.375rem)] sm:max-w-none justify-self-center w-full" : ""
          ]}
        >
          <!-- Arched Card Image Top -->
          <div class="h-32 sm:h-44 lg:h-48 w-full overflow-hidden bg-brand-sand">
            <Image
              src={item.image}
              alt={item.title}
              width={400}
              height={320}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Card Content Bottom -->
          <div class="p-3 sm:p-5 flex flex-col items-center justify-center text-center flex-1">
            <h3 class="font-serif font-bold text-sm sm:text-base lg:text-lg text-brand-charcoal uppercase tracking-wider leading-snug group-hover:text-brand-burgundy transition-colors">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-brand-charcoal-dark font-sans font-medium mt-1 leading-snug">
              {item.subtitle}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
