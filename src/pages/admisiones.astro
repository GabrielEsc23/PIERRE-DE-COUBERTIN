---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AdmissionsBanner from '../components/AdmissionsBanner.astro';
import AdmissionsPricing from '../components/AdmissionsPricing.astro';
import AdmissionsProcess from '../components/AdmissionsProcess.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Admisiones y Colegiaturas 2026-2027 | Colegio Pierre de Coubertin"
  description="Conoce nuestra estructura transparente de inversión educativa: colegiaturas, matrícula, paquetes de uniformes y servicios adicionales. Inicia el proceso de postulación para tus hijos."
>
  <Header />
  <main class="flex-grow overflow-x-clip">
    <AdmissionsBanner />
    <AdmissionsPricing />
    <AdmissionsProcess />
    <ContactSection />
  </main>
  <Footer />
</Layout>
