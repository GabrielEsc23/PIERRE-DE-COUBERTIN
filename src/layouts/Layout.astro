---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Colegio Pierre de Coubertin | Formación Integral",
	description = "Colegio Pierre de Coubertin. Formación integral, valores y excelencia académica. Potenciamos el talento y la confianza de cada estudiante para construir un mejor futuro."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- Google Fonts: Public Sans (Prueba tipográfica temporal) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-brand-cream text-brand-charcoal min-h-screen flex flex-col font-sans antialiased overflow-x-clip">
		<slot />

		<script is:inline>
			document.documentElement.classList.add('has-js');

			const initAccentWordReveals = () => {
				document.querySelectorAll('.accent-word-reveal').forEach((el) => {
					if (el.hasAttribute('data-accent-init')) return;
					el.setAttribute('data-accent-init', 'true');

					const text = el.textContent ? el.textContent.trim() : '';
					el.setAttribute('aria-label', text);

					const tokens = text.match(/\S+|\s+/g) || [];
					let charCount = 0;
					const fragment = document.createDocumentFragment();

					tokens.forEach((token) => {
						if (/^\s+$/.test(token)) {
							const space = document.createElement('span');
							space.className = 'inline-block';
							space.innerHTML = '&nbsp;';
							space.setAttribute('aria-hidden', 'true');
							fragment.appendChild(space);
							charCount++;
						} else {
							const word = document.createElement('span');
							word.className = 'inline-block whitespace-nowrap';
							word.setAttribute('aria-hidden', 'true');

							Array.from(token).forEach((ch) => {
								const charSpan = document.createElement('span');
								charSpan.className = 'accent-char';
								charSpan.style.setProperty('--char-i', charCount.toString());
								charSpan.textContent = ch;
								charSpan.setAttribute('aria-hidden', 'true');
								word.appendChild(charSpan);
								charCount++;
							});
							fragment.appendChild(word);
						}
					});

					el.innerHTML = '';
					el.appendChild(fragment);
				});
			};

			const initScrollReveal = () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px 0px -40px 0px',
					threshold: 0.1
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							const el = entry.target;
							const animation = el.getAttribute('data-animate') || 'animate__fadeInUp';
							const delay = el.getAttribute('data-delay');
							if (delay) {
								el.style.animationDelay = delay;
							}
							el.classList.add('animate__animated', animation, 'is-revealed');
							obs.unobserve(el);
						}
					});
				}, observerOptions);

				document.querySelectorAll('.reveal-on-scroll').forEach(el => {
					observer.observe(el);
				});
			};

			const setupAnimations = () => {
				initAccentWordReveals();
				initScrollReveal();
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupAnimations);
			} else {
				setupAnimations();
			}
			document.addEventListener('astro:page-load', setupAnimations);
		</script>
	</body>
</html>
