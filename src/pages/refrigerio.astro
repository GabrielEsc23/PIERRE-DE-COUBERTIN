<script>
  function setupWeeklyMenu() {
    const weekTabs = document.querySelectorAll<HTMLButtonElement>('.week-tab-btn');
    const weekPanels = document.querySelectorAll<HTMLElement>('.week-menu-panel');
    const printBtn = document.getElementById('btn-print-menu') as HTMLButtonElement | null;

    // 1. Detect today's weekday (1 = Monday ... 5 = Friday) and highlight column
    const today = new Date().getDay();
    if (today >= 1 && today <= 5) {
      const todayDayIndex = today - 1; // 0 for Monday, 4 for Friday
      document.querySelectorAll<HTMLElement>(`.table-day-col[data-day-col="${todayDayIndex}"]`).forEach((th) => {
        th.classList.add('bg-brand-burgundy/10');
        const pill = th.querySelector('.table-today-pill');
        if (pill) {
          pill.classList.remove('hidden');
          pill.classList.add('inline-block');
        }
      });
    }

    // 2. Week Switching Tabs
    weekTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-week-target');

        // Update Tab buttons
        weekTabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('bg-brand-burgundy', 'text-white', 'shadow-sm');
          t.classList.add('bg-white', 'text-brand-charcoal', 'border', 'border-brand-charcoal/10');
        });

        tab.setAttribute('aria-selected', 'true');
        tab.classList.remove('bg-white', 'text-brand-charcoal', 'border', 'border-brand-charcoal/10');
        tab.classList.add('bg-brand-burgundy', 'text-white', 'shadow-sm');

        // Toggle Week Panels
        weekPanels.forEach((panel) => {
          if (panel.id === `panel-${targetId}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      });
    });

    // 3. Print Menu Button
    printBtn?.addEventListener('click', () => {
      window.print();
    });
  }

  // Setup tabs on initial load and view transitions
  setupWeeklyMenu();
  document.addEventListener('astro:page-load', setupWeeklyMenu);
</script>
