      <div class="hidden md:block absolute -right-10 lg:-right-4 top-1/2 -translate-y-1/2 w-28 lg:w-36 h-auto pointer-events-none select-none opacity-30 z-10">
        <img src={florBeigeSvg.src} alt="" class="w-full h-auto object-contain" aria-hidden="true" />
