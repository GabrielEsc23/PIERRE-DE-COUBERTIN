---
import florBeigeSvg from '../assets/FLOR-BEIGE.svg';

const alliances = [
  {
    name: 'Bachillerato Dual USA',
    category: 'Titulación Internacional',
    abbr: 'DUAL DIPLOMA',
    icon: 'graduation'
  },
  {
    name: 'Cambridge Assessment',
    category: 'Certificación en Inglés',
    abbr: 'CAMBRIDGE',
    icon: 'award'
  },
  {
    name: 'Alianza Francesa',
    category: 'Idioma y Cultura',
    abbr: 'ALLIANCE',
    icon: 'globe'
  },
  {
    name: 'Convenios Universitarios',
    category: 'Admisión Preferencial',
    abbr: 'CONVENIOS',
    icon: 'university'
  },
  {
    name: 'Movimiento Scout',
    category: 'Formación en Valores',
    abbr: 'SCOUTS',
    icon: 'compass'
  }
];

// 4 repeticiones (20 ítems en total = dos mitades idénticas de 10 ítems) para bucle infinito perfecto en cualquier resolución
const marqueeItems = [...alliances, ...alliances, ...alliances, ...alliances];
---

<section id="alianzas" class="py-12 lg:py-16 bg-brand-burgundy text-white relative overflow-hidden" aria-labelledby="alianzas-title">
  
  <!-- Left Laurel / Feather Decorative Branch -->
  <div class="hidden md:block absolute -left-12 lg:-left-6 top-1/2 -translate-y-1/2 w-28 lg:w-40 h-auto pointer-events-none select-none opacity-35 -scale-x-100 z-30">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain"
      aria-hidden="true"
    />
  </div>

  <!-- Right Laurel / Feather Decorative Branch -->
  <div class="hidden md:block absolute -right-12 lg:-right-6 top-1/2 -translate-y-1/2 w-28 lg:w-40 h-auto pointer-events-none select-none opacity-35 z-30">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain"
      aria-hidden="true"
    />
  </div>

  <div class="w-full relative z-10">
    
    <!-- Section Title Centered -->
    <div class="text-center max-w-3xl mx-auto mb-8 lg:mb-12 px-4 sm:px-6 reveal-on-scroll" data-animate="animate__fadeInUp">
      <h2 id="alianzas-title" class="text-2xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-wider text-white uppercase mb-3">
        ALIANZAS INSTITUCIONALES
      </h2>
      <p class="text-brand-cream text-base sm:text-lg lg:text-xl font-sans font-normal max-w-2xl mx-auto">
        Cooperación académica nacional e internacional que abre puertas al futuro de nuestros estudiantes.
      </p>
    </div>

    <!-- Infinite Marquee Carousel Container with Side Fade Masks -->
    <div 
      class="relative w-full overflow-hidden alliances-wrapper py-2 reveal-on-scroll"
      data-animate="animate__fadeIn"
      data-delay="200ms"
      role="region" 
      aria-label="Carrusel continuo de convenios y alianzas institucionales"
    >
      
      <!-- Left Fade Gradient Mask -->
      <div 
        class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 sm:w-28 lg:w-40 z-20 bg-gradient-to-r from-brand-burgundy via-brand-burgundy/80 to-transparent" 
        aria-hidden="true"
      ></div>

      <!-- Right Fade Gradient Mask -->
      <div 
        class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 sm:w-28 lg:w-40 z-20 bg-gradient-to-l from-brand-burgundy via-brand-burgundy/80 to-transparent" 
        aria-hidden="true"
      ></div>

      <!-- Track with infinite animation -->
      <div id="alliances-marquee-track" class="alliances-track flex gap-4 sm:gap-6 py-2 px-4">
        {marqueeItems.map((item, index) => (
          <div 
            class="group/card w-[250px] sm:w-[290px] shrink-0 p-5 sm:p-6 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 hover:bg-white/20 hover:border-white/30 transition-all duration-300 hover:-translate-y-1.5 shadow-lg text-center flex flex-col items-center justify-between"
            aria-hidden={index >= alliances.length ? "true" : undefined}
          >
            <!-- Icon Emblem -->
            <div class="w-14 h-14 rounded-full bg-brand-cream text-brand-burgundy flex items-center justify-center shadow-inner mb-3.5 group-hover/card:scale-110 group-hover/card:bg-white transition-all duration-300">
              {item.icon === 'graduation' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                </svg>
              )}
              {item.icon === 'award' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.004 0V5.625c0-.621-.504-1.125-1.125-1.125H9.621c-.621 0-1.125.504-1.125 1.125v8.625m5.004 0h-5.004" />
                </svg>
              )}
              {item.icon === 'globe' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
              )}
              {item.icon === 'university' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5M4.5 21V10.5M3 21h18" />
                </svg>
              )}
              {item.icon === 'compass' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <polygon points="12,6.5 15,12 12,17.5 9,12" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                </svg>
              )}
            </div>

            <!-- Alliance Name -->
            <h3 class="font-serif font-bold text-base sm:text-lg text-white tracking-wide leading-snug">
              {item.name}
            </h3>

            <!-- Category Badge -->
            <span class="inline-block mt-2.5 px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-white/10 text-brand-sand border border-white/10">
              {item.category}
            </span>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes alliancesMarquee {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .alliances-track {
    display: flex;
    width: max-content;
    animation: alliancesMarquee 38s linear infinite;
    will-change: transform;
  }

  /* Pause on hover and focus on desktop */
  .alliances-wrapper:hover .alliances-track,
  .alliances-wrapper:focus-within .alliances-track {
    animation-play-state: paused;
  }

  /* Accessibility: Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .alliances-track {
      animation: none !important;
      transform: none !important;
      overflow-x: auto;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  function setupAlliancesCarousel() {
    const track = document.getElementById('alliances-marquee-track');
    if (!track) return;

    let touchResumeTimer: number | undefined;

    // Pause on touch for mobile reading, smooth resume after touch release
    track.addEventListener('touchstart', () => {
      if (touchResumeTimer) clearTimeout(touchResumeTimer);
      track.style.animationPlayState = 'paused';
    }, { passive: true });

    track.addEventListener('touchend', () => {
      touchResumeTimer = window.setTimeout(() => {
        track.style.animationPlayState = 'running';
      }, 1200);
    }, { passive: true });
  }

  // Run on initial load and support view transitions if used
  setupAlliancesCarousel();
  document.addEventListener('astro:page-load', setupAlliancesCarousel);
</script>
