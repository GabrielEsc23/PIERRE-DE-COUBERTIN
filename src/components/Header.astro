---
import { Image } from 'astro:assets';
import logoImg from '../assets/LOGO COLEGIO.png';

const navItems = [
  { name: 'Inicio', href: '#' },
  { name: 'Nosotros', href: '#historia' },
  { name: 'Oferta Académica', href: '#oferta-academica' },
  { name: 'Servicios Adicionales', href: '#servicios-adicionales' },
  { name: 'Admisiones', href: '#contactos' },
  { name: 'Noticias', href: '#noticias-eventos' },
  { name: 'Contactos', href: '#contactos' },
  { name: 'Comunicados', href: '#noticias-eventos' },
];
---

<header class="bg-brand-cream relative z-30 shadow-[0_4px_20px_-2px_rgba(69,76,78,0.08)] border-b border-brand-charcoal/5">
  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
    <div class="flex items-center justify-between h-20 lg:h-22 gap-2 lg:gap-3 xl:gap-6">
      
      <!-- Brand / Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">
        <Image 
          src={logoImg} 
          alt="PIERRE DE COUBERTIN COLEGIO" 
          width={60}
          height={68}
          class="h-11 sm:h-12 lg:h-13 xl:h-15 w-auto object-contain"
          loading="eager"
        />
        <div class="flex flex-col leading-[1.05]">
          <span class="font-serif font-bold text-brand-burgundy text-[1rem] sm:text-[1.1rem] xl:text-[1.25rem] tracking-wider">PIERRE DE</span>
          <span class="font-serif font-bold text-brand-burgundy text-[1rem] sm:text-[1.1rem] xl:text-[1.25rem] tracking-wider">COUBERTIN</span>
          <span class="text-[9px] sm:text-[10px] xl:text-[11px] font-bold tracking-[0.22em] text-brand-charcoal uppercase mt-0.5">COLEGIO</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden lg:flex items-center gap-2 lg:gap-2 xl:gap-3.5 2xl:gap-5 flex-shrink">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-[12px] lg:text-[12.5px] xl:text-[14.5px] 2xl:text-[16px] font-sans font-semibold text-brand-charcoal hover:text-brand-burgundy border-b-2 border-transparent hover:border-brand-burgundy pb-0.5 transition-all duration-200 whitespace-nowrap"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Portal Docentes CTA Desktop -->
      <div class="hidden lg:flex items-center flex-shrink-0">
        <a
          href="/portal-docentes"
          class="inline-flex items-center gap-1.5 xl:gap-2 bg-brand-burgundy text-white px-3.5 py-1.5 lg:px-3.5 lg:py-2 xl:px-6 xl:py-2.5 rounded-full text-[11px] xl:text-xs 2xl:text-sm font-bold tracking-wider xl:tracking-widest uppercase hover:bg-brand-burgundy-dark transition-colors shadow-sm whitespace-nowrap focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
        >
          PORTAL DOCENTES
          <svg class="w-3.5 h-3.5 xl:w-4 xl:h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button (WCAG 2.1 Operability) -->
      <div class="flex lg:hidden items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 -mr-2 rounded-xl text-brand-charcoal hover:bg-black/5 transition-colors focus-visible:ring-2 focus-visible:ring-brand-burgundy"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg id="hamburger-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Navigation Menu -->
    <nav
      id="mobile-nav"
      class="hidden lg:hidden flex-col gap-2 pt-2 pb-6 border-t border-brand-charcoal/10"
      aria-label="Navegación móvil"
    >
      <!-- Dedicated Portal Docentes Button inside Dropdown -->
      <div class="px-2 pt-2 pb-3">
        <a
          href="/portal-docentes"
          class="mobile-nav-link flex items-center justify-center gap-2.5 w-full bg-brand-burgundy text-white py-3.5 px-5 rounded-xl text-sm font-bold tracking-widest uppercase hover:bg-brand-burgundy-dark transition-colors shadow-sm focus-visible:ring-2 focus-visible:ring-brand-burgundy focus-visible:ring-offset-2"
        >
          <span>Portal Docentes</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>
      </div>

      <div class="flex flex-col gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link px-4 py-3 rounded-xl text-lg sm:text-xl font-serif font-bold text-brand-charcoal hover:text-brand-burgundy hover:bg-black/5 transition-colors"
          >
            {item.name}
          </a>
        ))}
      </div>
    </nav>

  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && mobileNav && hamburgerIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menuBtn.setAttribute('aria-label', !isExpanded ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      mobileNav.classList.toggle('hidden');
      mobileNav.classList.toggle('flex');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('hidden');
        mobileNav.classList.remove('flex');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
