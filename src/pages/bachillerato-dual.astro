        <blockquote class="font-serif italic text-2xl sm:text-3xl md:text-4xl text-white leading-relaxed mb-6 font-bold">
          "En Pierre de Coubertin, conectamos el aprendizaje con oportunidades para el futuro."
        </blockquote>

        <p class="text-brand-cream/80 text-sm sm:text-base font-sans tracking-widest uppercase font-semibold">
          Institución Educativa Pierre de Coubertin
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-12 lg:py-16 bg-brand-cream relative">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center">
