---
import florBeigeSvg from '../assets/FLOR-BEIGE.svg';

const alliances = [
  {
    name: 'Bachillerato Dual USA',
    category: 'Titulación Internacional',
    abbr: 'DUAL DIPLOMA'
  },
  {
    name: 'Cambridge Assessment',
    category: 'Certificación en Inglés',
    abbr: 'CAMBRIDGE'
  },
  {
    name: 'Alianza Francesa',
    category: 'Idioma y Cultura',
    abbr: 'ALLIANCE'
  },
  {
    name: 'Convenios Universitarios',
    category: 'Admisión Preferencial',
    abbr: 'CONVENIOS'
  },
  {
    name: 'Movimiento Scout',
    category: 'Formación en Valores',
    abbr: 'SCOUTS'
  }
];
---

<section id="alianzas" class="py-12 lg:py-16 bg-brand-burgundy text-white relative overflow-hidden">
  
  <!-- Left Laurel / Feather Decorative Branch -->
  <div class="hidden md:block absolute -left-12 lg:-left-6 top-1/2 -translate-y-1/2 w-28 lg:w-40 h-auto pointer-events-none select-none opacity-40 -scale-x-100">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain"
      aria-hidden="true"
    />
  </div>

  <!-- Right Laurel / Feather Decorative Branch -->
  <div class="hidden md:block absolute -right-12 lg:-right-6 top-1/2 -translate-y-1/2 w-28 lg:w-40 h-auto pointer-events-none select-none opacity-40">
    <img
      src={florBeigeSvg.src}
      alt=""
      class="w-full h-auto object-contain"
      aria-hidden="true"
    />
  </div>

  <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">
    
    <!-- Section Title Centered -->
    <div class="text-center max-w-3xl mx-auto mb-8 lg:mb-10">
      <div class="flex items-center justify-center gap-4 mb-3">
        <div class="h-px w-12 bg-[#ddd2c6]/40 hidden sm:block"></div>
        <img src={florBeigeSvg.src} alt="" class="w-6 h-6 object-contain opacity-80" aria-hidden="true" />
        <div class="h-px w-12 bg-[#ddd2c6]/40 hidden sm:block"></div>
      </div>

      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-wider text-white uppercase mb-3">
        ALIANZAS INSTITUCIONALES
      </h2>
      <p class="text-brand-cream text-sm sm:text-base font-sans font-normal max-w-2xl mx-auto">
        Cooperación académica nacional e internacional que abre puertas al futuro de nuestros estudiantes.
      </p>
    </div>

    <!-- Alliances Logos / Badges Grid (2-col balanced on mobile, 5-col on desktop) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-6 w-full">
      {alliances.map((item, index) => (
        <div class:list={[
          "group flex flex-col items-center justify-center p-4 sm:p-5 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 hover:bg-white/20 transition-all duration-300 hover:-translate-y-1 shadow-md text-center",
          index === 4 ? "col-span-2 sm:col-span-1 max-w-[calc(50%-0.375rem)] sm:max-w-none justify-self-center w-full" : ""
        ]}>
          <!-- Icon Emblem -->
          <div class="w-12 h-12 rounded-full bg-brand-cream text-brand-burgundy flex items-center justify-center font-serif font-bold text-xs shadow-inner mb-3 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.004 0V5.625c0-.621-.504-1.125-1.125-1.125H9.621c-.621 0-1.125.504-1.125 1.125v8.625m5.004 0h-5.004" />
            </svg>
          </div>

          <!-- Alliance Name -->
          <h3 class="font-serif font-bold text-xs sm:text-sm text-white tracking-wide leading-snug">
            {item.name}
          </h3>
          <p class="text-[11px] text-brand-sand font-sans mt-1">
            {item.category}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
