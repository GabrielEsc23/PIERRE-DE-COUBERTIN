---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import florBeige from '../assets/flor-beige.webp';


// Menú real del refrigerio escolar — Noviembre 2026 (Periodo 2026-2027)
// Fuente: "REFRIGERIO ESCOLAR MES NOVIEMBRE" (secciones Escuela y Colegio, mismo menú).
// Para actualizar cada mes: cambiar `menuMonth` y `menuWeeks`.
const menuMonth = {
  month: 'Noviembre',
  year: 2026,
  period: '2026-2027',
  sections: 'Escuela y Colegio',
  motto: 'La buena comida es la base de la auténtica felicidad; nuestro menú es tu pase a una vida de sabor y plenitud.',
  workingDays: 18,
  billedDays: 17,
  pricePerDay: '$2,75',
  total: '$46,75',
  note: 'Se compensa un día por el compartir de la colada morada (30 de octubre).',
};

type MenuDay = {
  date: string; // AAAA-MM-DD
  weekday: string;
  type: 'menu' | 'holiday' | 'suspension';
  text: string;
  detail?: string;
};

const menuWeeks: { label: string; days: MenuDay[] }[] = [
  {
    label: 'Semana 1',
    days: [
      { date: '2026-11-02', weekday: 'Lunes', type: 'holiday', text: 'Feriado', detail: 'Día de los Difuntos' },
      { date: '2026-11-03', weekday: 'Martes', type: 'holiday', text: 'Feriado', detail: 'Independencia de Cuenca' },
      { date: '2026-11-04', weekday: 'Miércoles', type: 'menu', text: 'Tigrillo con huevo frito, fruta y jugo de naranja.' },
      { date: '2026-11-05', weekday: 'Jueves', type: 'menu', text: 'Morocho con empanada de viento rellena de queso, fruta.' },
      { date: '2026-11-06', weekday: 'Viernes', type: 'menu', text: 'Croquetas de papa con atún, fruta y avena de naranjilla.' },
    ],
  },
  {
    label: 'Semana 2',
    days: [
      { date: '2026-11-09', weekday: 'Lunes', type: 'menu', text: 'Menestra de verde con arroz y salchicha, fruta y jugo de babaco.' },
      { date: '2026-11-10', weekday: 'Martes', type: 'menu', text: 'Chochos con tostado y ensalada, fruta y jugo de sandía.' },
      { date: '2026-11-11', weekday: 'Miércoles', type: 'menu', text: 'Hot-dog, fruta y té frío.' },
      { date: '2026-11-12', weekday: 'Jueves', type: 'menu', text: 'Tortilla de yuca con queso, fruta y jugo de sandía.' },
      { date: '2026-11-13', weekday: 'Viernes', type: 'menu', text: 'Torta de vainilla decorada, fruta y té de manzanilla.' },
    ],
  },
  {
    label: 'Semana 3',
    days: [
      { date: '2026-11-16', weekday: 'Lunes', type: 'menu', text: 'Humita rellena de queso, fruta y té aromático.' },
      { date: '2026-11-17', weekday: 'Martes', type: 'menu', text: 'Sánduche de pollo desmechado con tomate y lechuga, fruta y avena de maracuyá.' },
      { date: '2026-11-18', weekday: 'Miércoles', type: 'menu', text: 'Bizcochos con queso, yogur y fruta.' },
      { date: '2026-11-19', weekday: 'Jueves', type: 'menu', text: 'Llapingachos (tortilla de papa con chorizo, huevo frito y aguacate), fruta y jugo de mora.' },
      { date: '2026-11-20', weekday: 'Viernes', type: 'suspension', text: 'Suspensión obligatoria', detail: 'Decreto Ejecutivo 507' },
    ],
  },
  {
    label: 'Semana 4',
    days: [
      { date: '2026-11-23', weekday: 'Lunes', type: 'menu', text: 'Empanada de verde rellena de queso, fruta y jugo de tamarindo.' },
      { date: '2026-11-24', weekday: 'Martes', type: 'menu', text: 'Maduros con queso, fruta y jugo de naranja.' },
      { date: '2026-11-25', weekday: 'Miércoles', type: 'menu', text: 'Mote pillo, fruta y jugo de piña.' },
      { date: '2026-11-26', weekday: 'Jueves', type: 'menu', text: 'Arroz con ensalada rusa y pollo al horno, fruta y jugo de maracuyá.' },
      { date: '2026-11-27', weekday: 'Viernes', type: 'menu', text: 'Torrejas de queso, fruta y avena de maracuyá.' },
    ],
  },
  {
    label: 'Semana 5',
    days: [
      { date: '2026-11-30', weekday: 'Lunes', type: 'menu', text: 'Arroz relleno con maduros fritos, fruta y jugo de papaya.' },
    ],
  },
];

const weekdays = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'];
const dayNumber = (date: string) => Number(date.slice(8, 10));

const pillars = [
  {
    title: 'Energía y concentración',
    text: 'Carbohidratos de absorción lenta y proteínas de alto valor biológico para mantener la atención durante las clases.',
  },
  {
    title: 'Ingredientes frescos',
    text: 'Vegetales, frutas de temporada y carnes magras, preparados el mismo día en nuestra cocina.',
  },
  {
    title: 'Alergias e intolerancias',
    text: 'Registro individual de alergias e intolerancias, con opciones adaptadas para cada estudiante.',
  },
];

---

<Layout
  title="Refrigerio Escolar y Menú del Mes | Colegio Pierre de Coubertin"
  description="Menú mensual del refrigerio escolar del Colegio Pierre de Coubertin para Escuela y Colegio: platos de cada día, feriados y valor a cancelar del mes."
>
  <Header />

  <main class="flex-grow overflow-x-hidden bg-brand-cream">

    <!-- Hero -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">

        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#servicios-adicionales" class="hover:text-brand-burgundy transition-colors">Servicios Adicionales</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Refrigerio escolar</span>
          </nav>

          <a
            href="/#servicios-adicionales"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Servicios</span>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans mb-3">
              Nutrición y bienestar
            </span>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              Refrigerio y almuerzo: <span class="text-brand-burgundy">nutrición balanceada para crecer</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-8 font-sans">
              Platos preparados cada día con ingredientes frescos y supervisados por profesionales en nutrición infantil, para que tus hijos tengan energía durante toda la jornada.
            </p>

            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8">
              <a
                href="#menu-mensual"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors group"
              >
                <span>Ver el menú</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>
            </div>

            <dl class="flex flex-wrap gap-x-10 gap-y-4 pt-6 border-t border-brand-charcoal/10 w-full">
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Refrigerio</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">10:00 – 10:30</dd>
              </div>
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Almuerzo</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">12:30 – 13:30</dd>
              </div>
            </dl>
          </div>

          <div class="lg:col-span-6 w-full">
            <img
              src="https://images.unsplash.com/photo-1551218372-a8789b81b253?auto=format&fit=crop&w=1200&q=80"
              alt="Almuerzo saludable servido en el comedor escolar"
              class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center rounded-3xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Filosofía nutricional: 3 puntos breves -->
    <section class="py-14 lg:py-20 bg-brand-sand relative overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Filosofía nutricional
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal">
            Alimentación pensada para aprender mejor
          </h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 max-w-6xl mx-auto">
          {pillars.map((pillar, idx) => (
            <li class="border-t-2 border-brand-burgundy pt-6 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay={`${(idx + 1) * 100}ms`}>
              <span class="block font-serif font-bold text-3xl text-brand-burgundy mb-4" aria-hidden="true">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <h3 class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mb-2">{pillar.title}</h3>
              <p class="text-base text-brand-charcoal-dark font-sans leading-relaxed">{pillar.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Menú del mes -->
    <section id="menu-mensual" class="py-14 lg:py-20 bg-brand-beige relative section-border-bottom print-area scroll-mt-4">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">

        <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Menú del mes · Periodo {menuMonth.period}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Refrigerio de <span class="text-brand-burgundy">{menuMonth.month.toLowerCase()}</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg font-medium leading-relaxed font-sans">
            Menú para las secciones de {menuMonth.sections}.
          </p>
          <p class="mt-3 text-sm sm:text-base italic text-brand-charcoal/80 font-sans">
            “{menuMonth.motto}”
          </p>
        </div>

        <div class="max-w-6xl mx-auto mb-6 flex justify-end no-print">
          <button
            type="button"
            id="btn-print-menu"
            class="min-h-10 text-sm font-bold text-brand-burgundy underline-offset-4 hover:underline cursor-pointer"
          >
            Imprimir menú
          </button>
        </div>

        <div class="max-w-6xl mx-auto">
          <!-- Escritorio: calendario mensual -->
          <div class="hidden lg:block print:block overflow-hidden rounded-3xl bg-white border border-brand-charcoal/10">
            <div class="relative overflow-hidden flex items-baseline gap-3 px-6 py-5 bg-brand-burgundy text-white">
              <span class="font-serif font-bold text-xl xl:text-2xl">{menuMonth.month} {menuMonth.year}</span>
              <span class="text-sm xl:text-base text-[#ead9c8]">Sección {menuMonth.sections}</span>
              <img
                src={florBeige.src}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="no-print absolute -right-4 -top-16 w-28 h-auto opacity-25 pointer-events-none select-none rotate-[70deg]"
              />
            </div>
            <table class="w-full table-fixed border-collapse text-left font-sans">
              <caption class="sr-only">Menú del refrigerio de {menuMonth.month.toLowerCase()} {menuMonth.year}, de lunes a viernes</caption>
              <colgroup>
                <col class="w-32 xl:w-36" />
                {weekdays.map(() => <col />)}
              </colgroup>
              <thead>
                <tr class="border-b-2 border-brand-burgundy">
                  <th scope="col" class="p-4 bg-brand-cream/60"><span class="sr-only">Semana</span></th>
                  {weekdays.map((weekday) => (
                    <th scope="col" class="p-4 font-serif font-bold text-lg text-brand-charcoal">{weekday}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-charcoal/10">
                {menuWeeks.map((week) => (
                  <tr>
                    <th scope="row" class="p-4 align-top bg-brand-cream/60">
                      <span class="block text-xs font-bold uppercase tracking-[0.16em] text-brand-burgundy">{week.label}</span>
                    </th>
                    {weekdays.map((weekday) => {
                      const day = week.days.find((d) => d.weekday === weekday);
                      if (!day) return <td class="p-4 bg-brand-cream/40" aria-hidden="true"></td>;
                      return (
                        <td class="menu-day p-4 align-top transition-colors" data-date={day.date}>
                          <span class="flex items-center justify-between gap-2 mb-1.5">
                            <span class="font-serif font-bold text-lg text-brand-charcoal">{dayNumber(day.date)}</span>
                            <span class="today-label hidden text-xs font-bold uppercase tracking-[0.2em] text-brand-burgundy">Hoy</span>
                          </span>
                          {day.type === 'menu' ? (
                            <span class="block text-[15px] leading-relaxed text-brand-charcoal-dark">{day.text}</span>
                          ) : (
                            <span class="block text-[15px] leading-snug">
                              <span class="block font-bold uppercase tracking-wide text-brand-burgundy">{day.text}</span>
                              {day.detail && <span class="block text-brand-charcoal-dark mt-0.5">{day.detail}</span>}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Móvil y tablet: una lista por semana -->
          <div class="lg:hidden print:hidden flex flex-col gap-8">
            {menuWeeks.map((week) => (
              <div>
                <h3 class="font-serif font-bold text-xl text-brand-burgundy pb-3 mb-4 border-b-2 border-brand-burgundy">
                  {week.label}
                </h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {week.days.map((day) => (
                    <li class="menu-day flex gap-4 rounded-2xl bg-white border border-brand-charcoal/10 p-5" data-date={day.date}>
                      <span class="flex-shrink-0 w-14 text-center">
                        <span class="block text-xs font-bold uppercase tracking-wider text-brand-charcoal/70">{day.weekday.slice(0, 3)}</span>
                        <span class="block font-serif font-bold text-3xl text-brand-charcoal leading-tight">{dayNumber(day.date)}</span>
                      </span>
                      <span class="flex-1 min-w-0">
                        <span class="today-label hidden text-xs font-bold uppercase tracking-[0.2em] text-brand-burgundy mb-1">Hoy</span>
                        {day.type === 'menu' ? (
                          <span class="block text-base leading-relaxed text-brand-charcoal-dark">{day.text}</span>
                        ) : (
                          <span class="block">
                            <span class="block font-bold uppercase tracking-wide text-brand-burgundy">{day.text}</span>
                            {day.detail && <span class="block text-brand-charcoal-dark">{day.detail}</span>}
                          </span>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Valor del mes -->
          <div class="mt-8 lg:mt-10 rounded-3xl bg-white border border-brand-charcoal/10 p-6 sm:p-8">
            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:divide-x sm:divide-brand-charcoal/15 text-center">
              <div class="sm:px-4">
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70 mb-1">Días laborables</dt>
                <dd class="font-serif font-bold text-3xl text-brand-charcoal">{menuMonth.workingDays}</dd>
              </div>
              <div class="sm:px-4">
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70 mb-1">Días a cancelar</dt>
                <dd class="font-serif font-bold text-3xl text-brand-charcoal">{menuMonth.billedDays} × {menuMonth.pricePerDay}</dd>
              </div>
              <div class="sm:px-4">
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70 mb-1">Valor de {menuMonth.month.toLowerCase()}</dt>
                <dd class="font-serif font-bold text-3xl text-brand-burgundy">{menuMonth.total} <span class="text-base font-sans font-semibold text-brand-charcoal-dark">dólares</span></dd>
              </div>
            </dl>
            <p class="mt-6 pt-5 border-t border-brand-charcoal/10 text-center text-sm sm:text-base font-semibold text-brand-burgundy">
              Nota: {menuMonth.note}
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  @media print {
    header, footer, nav, .no-print {
      display: none !important;
    }
    main > section:not(.print-area) {
      display: none !important;
    }
    body, main, section {
      background: white !important;
      color: black !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .print-area {
      display: block !important;
      padding: 10px !important;
    }
    table {
      font-size: 10pt !important;
    }
    th, td {
      border: 1px solid #ddd !important;
      padding: 6px 8px !important;
      background: white !important;
    }
  }
</style>

<script>
  function setupMonthlyMenu() {
    // Resaltar el día de hoy si está en el menú del mes
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

    document.querySelectorAll<HTMLElement>(`.menu-day[data-date="${today}"]`).forEach((cell) => {
      cell.classList.add('bg-brand-cream', 'ring-2', 'ring-inset', 'ring-brand-burgundy');
      cell.querySelectorAll('.today-label').forEach((label) => {
        label.classList.remove('hidden');
        label.classList.add('block');
      });
    });

    document.getElementById('btn-print-menu')?.addEventListener('click', () => window.print());
  }

  setupMonthlyMenu();
</script>
