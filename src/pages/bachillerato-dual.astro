---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import fotoBd from '../assets/images/bachillerato-dual-beta.png';

const diplomas = [
  {
    country: 'Ecuador',
    title: 'Título de Bachiller Ecuatoriano',
    text: 'Otorgado por el Ministerio de Educación del Ecuador a través de la Unidad Educativa Pierre de Coubertin, con la sólida base científica, humanista y en valores propia de nuestro modelo formativo.',
  },
  {
    country: 'Estados Unidos',
    title: 'U.S. High School Diploma',
    text: 'Emitido por Advantages School International, escuela de los Estados Unidos con la que mantenemos una alianza para este programa.',
  },
];

const benefits = [
  {
    title: 'Inglés en contextos académicos',
    text: 'El idioma se utiliza como herramienta de estudio: lectura, redacción de ensayos, análisis y evaluación de materias curriculares.',
  },
  {
    title: 'Sistema educativo estadounidense',
    text: 'Experiencia formativa dentro de la estructura académica de EE.UU., con sus criterios de evaluación y metodologías.',
  },
  {
    title: 'Autonomía y competencias digitales',
    text: 'Desarrollo de la responsabilidad, la autogestión y la organización del tiempo, junto con el manejo de herramientas tecnológicas y entornos virtuales.',
  },
  {
    title: 'Opciones de educación superior',
    text: 'Un perfil académico más completo al momento de postular a universidades y becas, dentro y fuera del país.',
  },
];
---

<Layout
  title="Diploma DUAL: Dos Diplomas, Nuevas Oportunidades | Colegio Pierre de Coubertin"
  description="Programa de Diploma DUAL en alianza con Advantages School International (EE.UU.). Doble titulación: bachiller ecuatoriano y U.S. High School Diploma para estudiantes de Primero de Bachillerato."
>
  <Header />

  <main class="flex-grow overflow-x-hidden bg-brand-cream">

    <!-- Hero -->
    <section class="relative py-12 lg:py-18 xl:py-20 bg-brand-cream overflow-hidden section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10 relative z-10">

        <!-- Breadcrumb & Back navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 lg:mb-8">
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-sans text-brand-charcoal/70" aria-label="Miga de pan">
            <a href="/" class="hover:text-brand-burgundy transition-colors">Inicio</a>
            <span class="text-brand-charcoal/40">/</span>
            <a href="/#oferta-academica" class="hover:text-brand-burgundy transition-colors">Oferta Académica</a>
            <span class="text-brand-charcoal/40">/</span>
            <span class="text-brand-burgundy font-semibold">Diploma DUAL</span>
          </nav>

          <a
            href="/#oferta-academica"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-burgundy hover:text-brand-burgundy-dark transition-colors group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Volver a Oferta Académica</span>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans mb-3">
              Programa internacional de doble titulación
            </span>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[3.1rem] font-serif font-bold text-brand-charcoal leading-[1.15] mb-5">
              Diploma DUAL: <span class="text-brand-burgundy">dos diplomas, nuevas oportunidades</span>
            </h1>

            <p class="text-brand-charcoal-dark font-medium text-base sm:text-lg lg:text-xl leading-relaxed mb-8 font-sans">
              En la Institución Educativa Pierre de Coubertin ampliamos los horizontes académicos de nuestros estudiantes con el programa de Diploma DUAL, dirigido a estudiantes de Primero de Bachillerato, en alianza con <strong>Advantages School International</strong>, una escuela de Estados Unidos.
            </p>

            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8">
              <a
                href="#dos-titulos"
                class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors group"
              >
                <span>Conocer el programa</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>
              <a
                href="/admisiones"
                class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
              >
                <span>Admisiones y consultas</span>
              </a>
            </div>

            <dl class="flex flex-wrap gap-x-10 gap-y-4 pt-6 border-t border-brand-charcoal/10 w-full">
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Inicia en</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">1.º de Bachillerato</dd>
              </div>
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Al graduarse</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">2 títulos</dd>
              </div>
              <div>
                <dt class="text-xs font-bold tracking-[0.2em] uppercase text-brand-charcoal/70">Cohorte 2026</dt>
                <dd class="font-serif font-bold text-xl sm:text-2xl text-brand-charcoal mt-1">13 estudiantes</dd>
              </div>
            </dl>
          </div>

          <div class="lg:col-span-6 w-full">
            <Image
              src={fotoBd}
              alt="Estudiantes del programa Diploma DUAL en el Colegio Pierre de Coubertin"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full h-auto aspect-[4/3] sm:aspect-[16/11] object-cover object-center rounded-3xl"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Un programa, dos títulos -->
    <section id="dos-titulos" class="py-14 lg:py-20 bg-brand-sand relative section-border-bottom scroll-mt-4">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Doble titulación
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Un programa, <span class="text-brand-burgundy">dos títulos</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium leading-relaxed font-sans">
            Este programa ofrece la oportunidad de obtener el título de bachiller ecuatoriano y el diploma de secundaria estadounidense, al cumplir los requisitos académicos de ambas instituciones.
          </p>
        </div>

        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-stretch gap-4 md:gap-6">
          {diplomas.map((diploma, idx) => (
            <>
              {idx === 1 && (
                <div class="flex items-center justify-center" aria-hidden="true">
                  <span class="w-14 h-14 rounded-full bg-brand-burgundy text-white flex items-center justify-center font-serif font-bold text-3xl leading-none">+</span>
                </div>
              )}
              <article
                class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-brand-charcoal/10 reveal-on-scroll"
                data-animate="animate__fadeInUp"
                data-delay={`${(idx + 1) * 100}ms`}
              >
                <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-brand-burgundy uppercase font-sans block mb-3">
                  {diploma.country}
                </span>
                <h3 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-4 leading-tight">
                  {diploma.title}
                </h3>
                <p class="text-base text-brand-charcoal-dark leading-relaxed font-sans">
                  {diploma.text}
                </p>
              </article>
            </>
          ))}
        </div>
      </div>
    </section>

    <!-- Primera cohorte: franja destacada -->
    <section class="py-12 lg:py-16 bg-white relative section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 reveal-on-scroll" data-animate="animate__fadeInUp">
          <p class="flex items-baseline gap-3 flex-shrink-0">
            <span class="font-serif font-bold text-8xl lg:text-9xl text-brand-burgundy leading-none tracking-tight">13</span>
            <span class="text-base font-bold uppercase tracking-[0.2em] text-brand-charcoal">estudiantes</span>
          </p>
          <div class="md:border-l md:border-brand-charcoal/15 md:pl-12">
            <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
              Hito institucional
            </span>
            <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-charcoal mb-3">
              Primera cohorte 2026 en marcha
            </h2>
            <p class="text-base sm:text-lg text-brand-charcoal-dark leading-relaxed font-sans">
              Nuestra primera cohorte 2026 está conformada por 13 estudiantes, quienes inician este camino de formación internacional. Su esfuerzo y dedicación representan el compromiso de nuestra institución por abrir puertas a una educación global y transformadora.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="py-14 lg:py-20 bg-brand-beige relative section-border-bottom">
      <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-10">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 reveal-on-scroll" data-animate="animate__fadeInUp">
          <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-brand-burgundy uppercase font-sans block mb-2">
            Valor agregado
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-brand-charcoal mb-4">
            Beneficios del <span class="text-brand-burgundy">Diploma DUAL</span>
          </h2>
          <p class="text-brand-charcoal-dark text-base sm:text-lg lg:text-xl font-medium leading-relaxed font-sans">
            Entre sus principales beneficios se encuentran el fortalecimiento del inglés en contextos académicos, la experiencia de estudiar dentro de un sistema educativo estadounidense y el desarrollo de habilidades integrales para el futuro.
          </p>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
          {benefits.map((benefit, idx) => (
            <li
              class="bg-white rounded-3xl p-6 sm:p-8 border border-brand-charcoal/10 flex items-start gap-5 sm:gap-6 reveal-on-scroll"
              data-animate="animate__fadeInUp"
              data-delay={`${(idx + 1) * 100}ms`}
            >
              <span class="font-serif font-bold text-3xl sm:text-4xl text-brand-burgundy leading-none flex-shrink-0 w-12" aria-hidden="true">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-charcoal mb-2">{benefit.title}</h3>
                <p class="text-sm sm:text-base text-brand-charcoal-dark leading-relaxed font-sans">{benefit.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Frase de cierre -->
    <section class="relative py-16 lg:py-24 bg-brand-burgundy text-white overflow-hidden section-border-bottom-dark">
      <div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 text-center reveal-on-scroll" data-animate="animate__fadeInUp">
        <p class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl leading-snug mb-8">
          Conectamos el aprendizaje con oportunidades para el futuro.
        </p>
        <p class="text-sm sm:text-base font-semibold tracking-widest uppercase text-[#ead9c8]">
          Institución Educativa Pierre de Coubertin
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 lg:py-16 bg-brand-cream relative">
      <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl text-brand-charcoal mb-4">
          ¿Tu hijo inicia Primero de Bachillerato?
        </h2>
        <p class="text-brand-charcoal-dark text-base sm:text-lg max-w-2xl mx-auto mb-8 font-sans">
          Conoce los requisitos, fechas de postulación e inversión del programa. Nuestro equipo de orientación está listo para asesorarte.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/admisiones"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-brand-burgundy text-white font-bold text-sm sm:text-base hover:bg-brand-burgundy-dark transition-colors"
          >
            <span>Ver admisiones</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/#contactos"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-white text-brand-charcoal hover:text-brand-burgundy border border-brand-charcoal/20 font-bold text-sm sm:text-base transition-colors"
          >
            <span>Contactar al Departamento Académico</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
